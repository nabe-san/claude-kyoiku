---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptBadge from '../../components/ConceptBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, question, concepts, relatedBooks, relatedUnits } = entry.data;

const allBooks = await getCollection('books');
const linkedBooks = allBooks.filter(b => relatedBooks.includes(b.id));
const allUnits = await getCollection('units');
const linkedUnits = allUnits.filter(u => relatedUnits.includes(u.id));
---

<BaseLayout title={title}>
  <!-- ── ヘッダー ── -->
  <header class="note-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">ホーム</a>
        <span>›</span>
        <a href="/notes/">思考ノート</a>
        <span>›</span>
        <span>{title}</span>
      </nav>

      <span class="note-badge">思考ノート</span>
      <h1 class="note-title">{title}</h1>

      {concepts.length > 0 && (
        <div class="concept-tags">
          {concepts.map(c => <ConceptBadge concept={c} size="sm" />)}
        </div>
      )}
    </div>
  </header>

  <!-- ── まだ考え続けている問い ── -->
  <section class="question-section">
    <div class="container">
      <div class="question-band">
        <span class="question-label">まだ考え続けている問い</span>
        <p class="question-text">{question}</p>
      </div>
    </div>
  </section>

  <!-- ── 本文 ── -->
  <article class="note-body">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <!-- ── この思考のもとになった記録 ── -->
  {(linkedBooks.length > 0 || linkedUnits.length > 0) && (
    <section class="related-section">
      <div class="container">
        <h2 class="side-section-title">この思考のもとになった記録</h2>

        {linkedBooks.length > 0 && (
          <div class="book-cards">
            {linkedBooks.map(book => (
              <a href={`/books/${book.id}/`} class="book-card card" style="text-decoration:none;color:inherit;">
                <p class="book-card-author">{book.data.author}{book.data.year ? `（${book.data.year}）` : ''}</p>
                <h3 class="book-title">{book.data.title}</h3>
                {book.data.summary && <p class="book-summary">{book.data.summary}</p>}
                <span class="btn btn-ghost" style="margin-top:0.75rem; font-size:0.82rem; display:inline-block;">
                  読書ノートを読む →
                </span>
              </a>
            ))}
          </div>
        )}

        {linkedUnits.length > 0 && (
          <div class="unit-links">
            {linkedUnits.map(unit => (
              <a href={`/units/${unit.id}/`} class="unit-link-card">
                <span class="unit-link-label">授業一覧</span>
                <span class="unit-link-title">{unit.data.title}</span>
                <span class="unit-link-question">{unit.data.bigQuestion}</span>
                <span class="unit-link-arrow">→</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ── ヘッダー ── */
  .note-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--text-muted); }
  .breadcrumb a:hover { color: var(--primary); }

  .note-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--node-note);
    background: rgba(249, 168, 212, 0.12);
    border: 1px solid rgba(249, 168, 212, 0.3);
    border-radius: 100px;
    padding: 0.2em 0.8em;
    margin-bottom: 1rem;
  }

  .note-title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    line-height: 1.35;
  }

  .concept-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ── 問い ── */
  .question-section {
    background: var(--bg);
    padding: 2.5rem 0;
  }

  .question-band {
    position: relative;
    background: var(--bg-elevated);
    border-left: 4px solid var(--node-note);
    border-radius: 0 12px 12px 0;
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-glow);
  }

  .question-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--node-note);
    margin-bottom: 0.75rem;
  }

  .question-text {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    line-height: 1.6;
    margin: 0;
  }

  /* ── 本文 ── */
  .note-body {
    padding: 3.5rem 0;
    background: var(--bg);
  }

  /* ── 関連記録 ── */
  .related-section {
    padding: 2.5rem 0 3.5rem;
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
  }

  .side-section-title {
    font-size: 1.1rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .book-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .book-card { padding: 1.5rem; }
  .book-title {
    font-size: 1rem;
    font-family: "Noto Serif JP", serif;
    color: var(--text);
    margin-bottom: 0.6rem;
  }
  .book-summary {
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 0;
  }

  .unit-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .unit-link-card {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    padding: 1rem 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .unit-link-card:hover {
    border-color: var(--primary);
    box-shadow: 0 2px 10px rgba(146, 64, 14, 0.1);
  }

  .unit-link-label {
    font-size: 0.72rem;
    color: var(--node-unit);
    font-weight: 600;
    padding: 0.2em 0.6em;
    background: rgba(110, 231, 183, 0.1);
    border-radius: 100px;
    white-space: nowrap;
  }

  .unit-link-title {
    font-size: 0.95rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
  }

  .unit-link-question {
    font-size: 0.82rem;
    color: var(--text-muted);
    grid-column: 2;
    margin-top: -0.5rem;
  }

  .unit-link-arrow {
    color: var(--text-dim);
    transition: transform 0.2s, color 0.2s;
    grid-row: 1 / 3;
    grid-column: 4;
  }
  .unit-link-card:hover .unit-link-arrow {
    transform: translateX(3px);
    color: var(--primary);
  }
</style>
