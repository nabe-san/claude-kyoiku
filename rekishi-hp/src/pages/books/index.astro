---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptBadge from '../../components/ConceptBadge.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { coversBySlug } from '../../lib/covers';

const books = await getCollection('books');
---

<BaseLayout title="読書ノート">
  <header class="page-header">
    <div class="container">
      <h1 class="page-title">読書ノート</h1>
      <p class="page-desc">授業づくりの参考にした本の記録。概念タグを通じて多面的・多角的な視点を得ることができる。</p>
    </div>
  </header>

  <div class="container books-container">
    {books.length === 0 ? (
      <p class="empty-message">読書ノートはまだありません。</p>
    ) : (
      <div class="books-grid">
        {books.map(book => (
          <a href={`/books/${book.id}/`} class="book-card">
            <div class="book-body">
              {coversBySlug[book.id] && (
                <Image src={coversBySlug[book.id]} alt="" class="book-cover" width={140} />
              )}
              <p class="book-author">{book.data.author}{book.data.year ? `（${book.data.year}）` : ''}</p>
              <h2 class="book-title">{book.data.title}</h2>
              {book.data.summary && (
                <p class="book-summary">{book.data.summary}</p>
              )}
              <div class="book-concepts">
                {book.data.concepts.map(c => (
                  <span class="concept-chip">{c}</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-family: "Noto Serif JP", serif;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .page-desc {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
  }

  .books-container {
    padding: 3rem 1.5rem 5rem;
  }

  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .book-card {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 10px solid var(--primary);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .book-card:hover {
    box-shadow: 0 4px 20px rgba(146, 64, 14, 0.12);
    transform: translateY(-2px);
  }

  .book-cover {
    float: right;
    width: 72px;
    height: auto;
    margin: 0 0 0.75rem 1rem;
    border-radius: 3px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .book-body {
    padding: 1.5rem;
  }

  .book-author {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 0 0 0.4rem;
    letter-spacing: 0.02em;
  }

  .book-title {
    font-size: 1.15rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .book-summary {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-concepts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .concept-chip {
    display: inline-block;
    font-size: 0.75rem;
    color: var(--primary);
    border: 1px solid rgba(146, 64, 14, 0.25);
    border-radius: 100px;
    padding: 0.2em 0.7em;
    background: rgba(146, 64, 14, 0.05);
  }

  .empty-message {
    text-align: center;
    color: var(--text-dim);
    padding: 4rem 0;
    font-size: 1rem;
  }
</style>
