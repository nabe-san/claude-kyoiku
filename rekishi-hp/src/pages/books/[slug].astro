---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptBadge from '../../components/ConceptBadge.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { coversBySlug } from '../../lib/covers';

const { slug } = Astro.params;
const entry = slug ? await getEntry('books', slug) : undefined;

if (!entry) {
  return new Response('Not Found', { status: 404 });
}

const { title, author, year, publisher, summary, concepts, relatedUnits } = entry.data;
const cover = coversBySlug[entry.id];

const allUnits = await getCollection('units');
const linkedUnits = allUnits.filter(u => relatedUnits.includes(u.id));

// 本文（引用ブロックの連なり）を1ブロックずつパースする。
// 各ブロックの形式:
//   <!-- concepts: タグ1, タグ2 -->
//   ## 見出し
//
//   > 引用文（複数行の場合あり）
//
//   *出典*
//
//   ---
interface CitationBlock {
  concepts: string[];
  heading: string;
  paragraphs: string[];
  citation: string;
}

function linesToParagraphs(lines: string[]): string[] {
  const paragraphs: string[] = [];
  let current: string[] = [];
  for (const line of lines) {
    if (line.trim() === '') {
      if (current.length) {
        paragraphs.push(current.join(' '));
        current = [];
      }
    } else {
      current.push(line.trim());
    }
  }
  if (current.length) paragraphs.push(current.join(' '));
  return paragraphs;
}

function parseCitations(body: string): CitationBlock[] {
  const normalized = body.replace(/\r\n/g, '\n').trim();
  const rawBlocks = normalized.split(/\n-{3,}\n/);

  return rawBlocks
    .map(raw => {
      const commentMatch = raw.match(/<!--\s*concepts:\s*([^-]+?)\s*-->/);
      const concepts = commentMatch
        ? commentMatch[1].split(',').map(s => s.trim()).filter(Boolean)
        : [];

      const headingMatch = raw.match(/^##\s+(.+)$/m);
      const heading = headingMatch ? headingMatch[1].trim() : '';

      const quoteLines = raw
        .split('\n')
        .filter(l => l.trim().startsWith('>'))
        .map(l => l.replace(/^>\s?/, ''));
      const paragraphs = linesToParagraphs(quoteLines);

      const citationMatch = raw.match(/^\*(.+)\*\s*$/m);
      const citation = citationMatch ? citationMatch[1].trim() : '';

      return { concepts, heading, paragraphs, citation };
    })
    .filter(block => block.heading || block.paragraphs.length > 0);
}

const citations = parseCitations(entry.body ?? '');

// この本の全引用が持つ概念タグ（フロントマターの concepts とは別に、引用単位の絞り込み用）
const citationTagCounts = new Map<string, number>();
for (const c of citations) {
  for (const tag of c.concepts) {
    citationTagCounts.set(tag, (citationTagCounts.get(tag) ?? 0) + 1);
  }
}
const citationTags = [...citationTagCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title={title} noindex>

  <!-- ── ヘッダー ── -->
  <header class="book-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">ホーム</a>
        <span>›</span>
        <a href="/books/">読書ノート</a>
        <span>›</span>
        <span>{title}</span>
      </nav>

      <div class="book-header-row">
        {cover && <Image src={cover} alt="" class="book-cover-lg" width={140} height={200} />}
        <div class="book-header-text">
          <div class="book-badge-row">
            <span class="book-badge">読書ノート</span>
            <span class="depth-badge">もっと知りたい人のための知識</span>
          </div>

          <h1 class="book-title">{title}</h1>
          <p class="book-meta">
            {author}
            {year && <span class="meta-sep">·</span>}
            {year && <span>{year}年</span>}
            {publisher && <span class="meta-sep">·</span>}
            {publisher && <span>{publisher}</span>}
          </p>

          {concepts.length > 0 && (
            <div class="concept-tags">
              {concepts.map(c => <ConceptBadge concept={c} size="sm" />)}
            </div>
          )}
        </div>
      </div>
    </div>
  </header>

  <!-- ── 要旨 ── -->
  {summary && (
    <div class="summary-band">
      <div class="container">
        <p class="summary-text">{summary}</p>
      </div>
    </div>
  )}

  <!-- ── 引用の絞り込み ── -->
  {citationTags.length > 0 && (
    <div class="citation-filter-bar">
      <div class="container">
        <p class="citation-filter-label">引用を概念タグで絞り込む</p>
        <div class="citation-filter-row" id="citation-filter-row">
          <button class="citation-filter-btn active" data-tag="">すべて</button>
          {citationTags.map(([tag, count]) => (
            <button class="citation-filter-btn" data-tag={tag}>{tag}（{count}）</button>
          ))}
        </div>
      </div>
    </div>
  )}

  <!-- ── 本文（引用） ── -->
  <article class="book-body">
    <div class="container">
      <div class="prose">
        {citations.map(c => (
          <div class="citation-block" data-concepts={c.concepts.join(',')}>
            {c.heading && <h2>{c.heading}</h2>}
            {c.paragraphs.length > 0 && (
              <blockquote>
                {c.paragraphs.map(p => <p>{p}</p>)}
              </blockquote>
            )}
            {c.citation && <p><em>{c.citation}</em></p>}
            {c.concepts.length > 0 && (
              <div class="citation-tags">
                {c.concepts.map(tag => <ConceptBadge concept={tag} size="sm" />)}
              </div>
            )}
          </div>
        ))}
        <p class="citation-empty-message" id="citation-empty-message">このタグを持つ引用はありません。</p>
      </div>
    </div>
  </article>

  <!-- ── 関連授業構成 ── -->
  {linkedUnits.length > 0 && (
    <section class="related-units">
      <div class="container">
        <h2 class="related-title">この本を参照した授業一覧</h2>
        <div class="unit-links">
          {linkedUnits.map(u => (
            <a href={`/units/${u.id}/`} class="unit-link-card">
              <span class="unit-link-label">授業一覧</span>
              <span class="unit-link-title">{u.data.title}</span>
              <span class="unit-link-question">{u.data.bigQuestion}</span>
              <span class="unit-link-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.citation-filter-btn');
  const citationBlocks = document.querySelectorAll<HTMLElement>('.citation-block');
  const emptyMsg = document.getElementById('citation-empty-message');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tag = btn.dataset.tag ?? '';
      filterBtns.forEach(b => b.classList.toggle('active', b === btn));

      let visibleCount = 0;
      citationBlocks.forEach(block => {
        const blockTags = block.dataset.concepts?.split(',') ?? [];
        const show = tag === '' || blockTags.includes(tag);
        block.hidden = !show;
        if (show) visibleCount++;
      });

      if (emptyMsg) emptyMsg.hidden = visibleCount > 0;
    });
  });

  if (emptyMsg) emptyMsg.hidden = true;
</script>

<style>
  /* ── ヘッダー ── */
  .book-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--text-muted); }
  .breadcrumb a:hover { color: var(--primary); }

  .book-header-row {
    display: flex;
    gap: 1.75rem;
    align-items: flex-start;
  }

  .book-cover-lg {
    width: 140px;
    height: auto;
    flex-shrink: 0;
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
  }

  .book-header-text {
    flex: 1;
    min-width: 0;
  }

  .book-badge-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .book-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--node-book);
    background: rgba(252, 211, 77, 0.12);
    border: 1px solid rgba(252, 211, 77, 0.3);
    border-radius: 100px;
    padding: 0.2em 0.8em;
  }

  .depth-badge {
    display: inline-block;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: "Noto Serif JP", serif;
    font-style: italic;
    padding: 0.1em 0;
  }

  .book-title {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .book-meta {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .meta-sep {
    margin: 0 0.4em;
    color: var(--text-dim);
  }

  .concept-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  /* ── 要旨バンド ── */
  .summary-band {
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0;
  }
  .summary-text {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.8;
    max-width: 72ch;
    margin: 0;
  }

  /* ── 引用の絞り込みバー ── */
  .citation-filter-bar {
    background: var(--bg-surface);
    padding: 1.25rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .citation-filter-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }
  .citation-filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .citation-filter-btn {
    display: inline-block;
    padding: 0.4em 1em;
    font-size: 0.85rem;
    font-family: "Noto Sans JP", sans-serif;
    color: var(--primary);
    border: 1px solid rgba(146, 64, 14, 0.3);
    border-radius: 100px;
    background: rgba(146, 64, 14, 0.06);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .citation-filter-btn:hover:not(.active) {
    background: rgba(146, 64, 14, 0.12);
  }
  .citation-filter-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
  }

  /* ── 本文 ── */
  .book-body {
    padding: 3.5rem 0;
    background: var(--bg);
  }

  .citation-empty-message {
    text-align: center;
    color: var(--text-dim);
    padding: 3rem 0;
  }

  .citation-tags {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: -1.5rem;
    margin-bottom: 2.25rem;
  }

  /* ── 関連授業単元 ── */
  .related-units {
    padding: 2.5rem 0 3.5rem;
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
  }

  .related-title {
    font-size: 1.1rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .unit-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .unit-link-card {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    padding: 1rem 1.5rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .unit-link-card:hover {
    border-color: var(--primary);
    box-shadow: 0 2px 10px rgba(146, 64, 14, 0.1);
  }

  .unit-link-label {
    font-size: 0.72rem;
    color: var(--node-unit);
    font-weight: 600;
    padding: 0.2em 0.6em;
    background: rgba(110, 231, 183, 0.1);
    border-radius: 100px;
    white-space: nowrap;
  }

  .unit-link-title {
    font-size: 0.95rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
  }

  .unit-link-question {
    font-size: 0.82rem;
    color: var(--text-muted);
    grid-column: 2;
    margin-top: -0.5rem;
  }

  .unit-link-arrow {
    color: var(--text-dim);
    transition: transform 0.2s, color 0.2s;
    grid-row: 1 / 3;
    grid-column: 4;
  }
  .unit-link-card:hover .unit-link-arrow {
    transform: translateX(3px);
    color: var(--primary);
  }
</style>
