---
interface Props {
  subject: 'history-general' | 'japanese-history' | 'civics';
}

const labels = {
  'history-general':  '歴史総合',
  'japanese-history': '日本史探究',
  'civics':           '公共',
};

const { subject } = Astro.props;
---

<span class:list={['subject-badge', `subject-badge--${subject}`]}>
  {labels[subject]}
</span>

<style>
  .subject-badge {
    display: inline-block;
    padding: 0.25em 0.8em;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }
  .subject-badge--history-general {
    background: var(--badge-history-bg);
    color: var(--badge-history-fg);
  }
  .subject-badge--japanese-history {
    background: var(--badge-japanese-bg);
    color: var(--badge-japanese-fg);
  }
  .subject-badge--civics {
    background: var(--badge-civics-bg);
    color: var(--badge-civics-fg);
  }
</style>
