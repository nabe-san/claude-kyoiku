---
import ConceptBadge from './ConceptBadge.astro';
import SubjectBadge from './SubjectBadge.astro';
import UnitVisual from './UnitVisual.astro';
import { Image } from 'astro:assets';
import { unitVisualsBySlug, unitVisualFocus } from '../lib/unit-visuals';

interface Props {
  id: string;
  title: string;
  subject: 'history-general' | 'japanese-history' | 'civics';
  concepts: string[];
  bigQuestion: string;
  visual?: 'imperialism' | 'industrial' | 'insei' | 'default';
}
const { id, title, subject, concepts, bigQuestion, visual = 'default' } = Astro.props;
const customVisual = unitVisualsBySlug[id];
---

<article class="unit-card card">
  <!-- カード全体のクリック領域（透明オーバーレイ） -->
  <a href={`/units/${id}/`} class="card-overlay" aria-label={title}></a>

  {customVisual ? (
    <Image
      src={customVisual}
      alt=""
      class="unit-visual-img"
      width={480}
      style={`object-position: ${unitVisualFocus[id] ?? 'center'}`}
    />
  ) : (
    <UnitVisual visual={visual} />
  )}

  <div class="unit-card-header">
    <SubjectBadge subject={subject} />
    <span class="unit-card-arrow">→</span>
  </div>

  <h3 class="unit-card-title">{title}</h3>

  <p class="unit-card-question">{bigQuestion}</p>

  <div class="unit-card-concepts">
    {concepts.slice(0, 3).map(c => <ConceptBadge concept={c} size="sm" />)}
    {concepts.length > 3 && <span class="more-badge">+{concepts.length - 3}</span>}
  </div>
</article>

<style>
  .unit-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: inherit;
    overflow: hidden;
  }

  /* カード全体を覆う透明リンク */
  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
  }

  /* 概念タグはオーバーレイより前面に（クリック可能にする） */
  .unit-card-concepts {
    position: relative;
    z-index: 3;
  }

  .unit-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .unit-card-arrow {
    color: var(--text-dim);
    font-size: 1.1rem;
    transition: transform 0.2s, color 0.2s;
  }

  .unit-card:hover .unit-card-arrow {
    transform: translateX(3px);
    color: var(--primary);
  }

  .unit-visual-img {
    display: block;
    width: calc(100% + 3rem);
    height: 108px;
    object-fit: cover;
    margin: -1.5rem -1.5rem 0.25rem;
    border-bottom: 1px solid var(--border);
  }

  .unit-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.4;
    font-family: "Noto Serif JP", serif;
  }

  .unit-card-question {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .unit-card-concepts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .more-badge {
    display: inline-block;
    padding: 0.2em 0.6em;
    font-size: 0.72rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 100px;
  }
</style>
