{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "enum": [
        "history-general",
        "japanese-history",
        "civics"
      ]
    },
    "visual": {
      "default": "default",
      "type": "string",
      "enum": [
        "imperialism",
        "industrial",
        "insei",
        "default"
      ]
    },
    "chapter": {
      "type": "number"
    },
    "group": {
      "type": "number"
    },
    "section": {
      "type": "number"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bigQuestion": {
      "type": "string"
    },
    "subQuestion": {
      "type": "string"
    },
    "overview": {
      "type": "string"
    },
    "keyTerms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "answer": {
      "type": "string"
    },
    "relatedBooks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedNotes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "materials": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        },
        "required": [
          "label",
          "file"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "subject",
    "concepts",
    "bigQuestion"
  ]
}