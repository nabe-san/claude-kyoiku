{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "publisher": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "concepts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedUnits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relatedBookLinks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "slug"
        ]
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "author"
  ]
}