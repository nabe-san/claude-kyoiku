---
import LineIcon from './LineIcon.astro';

interface Props {
  concept: string;
  size?: 'sm' | 'md';
}
const { concept, size = 'md' } = Astro.props;

const conceptIconMap: Record<string, 'landmark' | 'users' | 'pin' | 'spark' | 'tag'> = {
  '帝国主義': 'landmark',
  '国民国家': 'users',
  '植民地': 'pin',
  '近代化': 'spark',
};
const iconName = conceptIconMap[concept] ?? 'tag';
---

<a
  href={`/concepts/${encodeURIComponent(concept)}/`}
  class:list={['concept-badge', `concept-badge--${size}`]}
>
  <LineIcon name={iconName} size={size === 'sm' ? 13 : 15} />
  {concept}
</a>

<style>
  .concept-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.3em 0.85em;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--primary);
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .concept-badge:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px var(--glow-color);
  }
  .concept-badge--sm {
    padding: 0.2em 0.65em;
    font-size: 0.72rem;
  }

  :global([data-theme="parchment"]) .concept-badge {
    background: rgba(0, 0, 0, 0.03);
  }
</style>
