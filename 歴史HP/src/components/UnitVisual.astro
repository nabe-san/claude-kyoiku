---
interface Props {
  visual?: 'imperialism' | 'industrial' | 'insei' | 'default';
}

const { visual = 'default' } = Astro.props;
---

<div class:list={['unit-visual', `unit-visual--${visual}`]} aria-hidden="true">
  <svg viewBox="0 0 420 116" preserveAspectRatio="none" class="unit-visual-svg" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <pattern id={`paper-lines-${visual}`} width="100%" height="16" patternUnits="userSpaceOnUse">
        <path d="M0 15.5H420" class="paper-line" />
      </pattern>
    </defs>
    <rect width="420" height="116" class="paper" />
    <rect width="420" height="116" fill={`url(#paper-lines-${visual})`} opacity="0.75" />

    {visual === 'imperialism' && (
      <>
        <circle cx="118" cy="56" r="31" class="fine-line" />
        <path d="M88 56h60M118 25c10 16 10 46 0 62M118 25c-10 16-10 46 0 62M94 40c15 6 33 6 48 0M94 72c15-6 33-6 48 0" class="fine-line" />
        <path d="M153 57C208 19 271 20 339 50" class="route dashed" />
        <path d="M150 64C206 86 266 83 341 58" class="route" />
        <path d="M282 54l35 9-33 9 9-9-11-9z" class="accent-fill" />
        <circle cx="176" cy="43" r="4" class="accent-dot" />
        <circle cx="246" cy="76" r="4" class="accent-dot" />
        <path d="M334 35h31v38h-31zM334 35l15 10 16-10M334 73l16-12 15 12" class="fine-line light" />
      </>
    )}

    {visual === 'industrial' && (
      <>
        <path d="M70 76h170v16H70zM86 45h28v31H86zM126 38h32v38h-32zM170 51h47v25h-47z" class="fine-line" />
        <path d="M94 45V27h13v18M136 38V20h13v18" class="fine-line" />
        <path d="M75 76l39-23 40 23 48-26 38 26" class="fine-line" />
        <path d="M265 78h91M277 90h70" class="rail" />
        <path d="M280 79l-10 11M306 79l-10 11M332 79l-10 11" class="rail-tie" />
        <circle cx="282" cy="52" r="18" class="fine-line" />
        <circle cx="282" cy="52" r="7" class="fine-line" />
        <path d="M282 34v8M282 62v8M264 52h8M292 52h8M269 39l6 6M289 59l6 6M269 65l6-6M289 45l6-6" class="fine-line light" />
        <path d="M236 31c12-9 23-8 31 1M219 23c14-11 30-10 41 0" class="smoke" />
      </>
    )}

    {visual === 'insei' && (
      <>
        <path d="M77 80h136M90 80V48h110v32M82 48h126L145 21 82 48z" class="fine-line" />
        <path d="M105 80V58M129 80V58M153 80V58M177 80V58" class="fine-line light" />
        <path d="M244 35h88c12 0 20 8 20 20s-8 20-20 20h-88c-12 0-20-8-20-20s8-20 20-20z" class="scroll" />
        <path d="M244 35c9 5 9 35 0 40M332 35c-9 5-9 35 0 40M263 48h50M263 61h42" class="fine-line" />
        <path d="M78 94c57-6 101-6 132 0M228 92c42-10 83-10 124 0" class="field-line" />
        <path d="M242 91V74M276 88V75M315 88V75" class="field-line" />
        <circle cx="145" cy="21" r="4" class="accent-dot" />
      </>
    )}

    {visual === 'default' && (
      <>
        <path d="M48 78C115 34 175 33 240 72" class="route" />
        <path d="M84 37C164 73 230 91 344 58" class="route" />
        <path d="M42 34C124 84 191 98 286 85" class="route light" />
        <circle cx="118" cy="57" r="4" class="accent-dot" />
        <circle cx="224" cy="44" r="4" class="accent-dot" />
        <circle cx="320" cy="64" r="4" class="accent-dot" />
        <path d="M361 49l12-7 12 7v25l-12 7-12-7zM373 42v39M361 49l12 7 12-7" class="fine-line" />
      </>
    )}
  </svg>
</div>

<style>
  .unit-visual {
    position: relative;
    height: 108px;
    margin: -1.5rem -1.5rem 0.25rem;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    background:
      radial-gradient(circle at 16% 24%, rgba(255, 255, 255, 0.48), transparent 28%),
      linear-gradient(115deg, rgba(146, 64, 14, 0.08), transparent 62%),
      var(--bg-surface);
  }

  .unit-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 58%, rgba(250, 247, 242, 0.22));
    pointer-events: none;
  }

  .unit-visual-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .paper {
    fill: color-mix(in srgb, var(--bg-surface) 88%, white);
  }

  .paper-line {
    stroke: rgba(146, 64, 14, 0.08);
    stroke-width: 1;
  }

  .fine-line,
  .route,
  .rail,
  .rail-tie,
  .scroll,
  .field-line,
  .smoke {
    fill: none;
    stroke: color-mix(in srgb, var(--primary) 58%, #7c5637);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.62;
  }

  .fine-line.light,
  .route.light {
    opacity: 0.35;
  }

  .route.dashed {
    stroke-dasharray: 5 7;
    opacity: 0.45;
  }

  .accent-dot,
  .accent-fill {
    fill: var(--primary);
    opacity: 0.5;
  }

  .rail,
  .rail-tie,
  .field-line {
    opacity: 0.42;
  }

  .smoke {
    opacity: 0.28;
  }

  .scroll {
    fill: rgba(146, 64, 14, 0.04);
  }

  .unit-visual--industrial .fine-line,
  .unit-visual--industrial .route,
  .unit-visual--industrial .rail,
  .unit-visual--industrial .rail-tie,
  .unit-visual--industrial .smoke {
    stroke: color-mix(in srgb, var(--primary) 48%, #5f6258);
  }

  .unit-visual--insei .fine-line,
  .unit-visual--insei .field-line,
  .unit-visual--insei .scroll {
    stroke: color-mix(in srgb, var(--primary) 50%, #704f3a);
  }
</style>
