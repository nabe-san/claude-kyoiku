---
// 概念ノードとコンテンツノードをつなぐネットワーク視覚化
// このSVGはHeroセクションの背景として使用する
---

<div class="network-hero-wrap" aria-hidden="true">
  <svg
    viewBox="0 0 900 420"
    preserveAspectRatio="xMidYMid slice"
    class="network-svg"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <!-- グロー フィルター -->
      <filter id="glow-concept" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="glow-content" x="-80%" y="-80%" width="260%" height="260%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- 動くドットのためのパスID（animateMotion用） -->
      <!-- エッジパスを定義（後のdots参照用） -->
      <path id="e-im-ko" d="M450,210 L220,130" />
      <path id="e-im-sh" d="M450,210 L680,130" />
      <path id="e-im-ki" d="M450,210 L190,310" />
      <path id="e-im-su" d="M450,210 L710,310" />
      <path id="e-ko-su" d="M220,130 L710,310" />
      <path id="e-sh-su" d="M680,130 L710,310" />
      <path id="e-ua-ko" d="M95,80  L220,130" />
      <path id="e-ub-im" d="M450,65  L450,210" />
      <path id="e-uc-sh" d="M810,155 L680,130" />
      <path id="e-ba-su" d="M805,340 L710,310" />
      <path id="e-na-ki" d="M95,370  L190,310" />
      <path id="e-nb-im" d="M450,385 L450,210" />

      <!-- グラデーション背景 -->
      <radialGradient id="hero-grad" cx="50%" cy="50%" r="60%">
        <stop offset="0%"   stop-color="var(--hero-to)"   stop-opacity="1"/>
        <stop offset="100%" stop-color="var(--hero-from)"  stop-opacity="1"/>
      </radialGradient>
    </defs>

    <!-- 背景 -->
    <rect width="900" height="420" fill="url(#hero-grad)" />

    <!-- ────────── エッジ（線） ────────── -->
    <g class="edges" stroke="var(--edge-color)" stroke-width="1.2" fill="none">
      <use href="#e-im-ko" class="edge" />
      <use href="#e-im-sh" class="edge" />
      <use href="#e-im-ki" class="edge" />
      <use href="#e-im-su" class="edge" />
      <use href="#e-ko-su" class="edge edge-secondary" />
      <use href="#e-sh-su" class="edge edge-secondary" />
      <use href="#e-ua-ko" class="edge edge-content" />
      <use href="#e-ub-im" class="edge edge-content" />
      <use href="#e-uc-sh" class="edge edge-content" />
      <use href="#e-ba-su" class="edge edge-content" />
      <use href="#e-na-ki" class="edge edge-content" />
      <use href="#e-nb-im" class="edge edge-content" />
    </g>

    <!-- ────────── 動くドット ────────── -->
    <g class="traveling-dots" fill="var(--node-concept)" opacity="0.9">
      <circle r="2.5">
        <animateMotion dur="4s" repeatCount="indefinite" begin="0s">
          <mpath href="#e-im-ko"/>
        </animateMotion>
      </circle>
      <circle r="2.5">
        <animateMotion dur="5s" repeatCount="indefinite" begin="1.5s">
          <mpath href="#e-im-sh"/>
        </animateMotion>
      </circle>
      <circle r="2.5">
        <animateMotion dur="4.5s" repeatCount="indefinite" begin="2.5s">
          <mpath href="#e-im-ki"/>
        </animateMotion>
      </circle>
      <circle r="2.5">
        <animateMotion dur="5.5s" repeatCount="indefinite" begin="0.8s">
          <mpath href="#e-im-su"/>
        </animateMotion>
      </circle>
      <circle r="2" fill="var(--node-unit)">
        <animateMotion dur="3.5s" repeatCount="indefinite" begin="1s">
          <mpath href="#e-ub-im"/>
        </animateMotion>
      </circle>
      <circle r="2" fill="var(--node-book)">
        <animateMotion dur="4.2s" repeatCount="indefinite" begin="3s">
          <mpath href="#e-ba-su"/>
        </animateMotion>
      </circle>
      <circle r="2" fill="var(--node-note)">
        <animateMotion dur="3.8s" repeatCount="indefinite" begin="2s">
          <mpath href="#e-nb-im"/>
        </animateMotion>
      </circle>
    </g>

    <!-- ────────── コンテンツノード（小）────────── -->
    <!-- 単元A -->
    <g class="content-node-group" style="--delay:0s">
      <circle cx="95" cy="80" r="7" fill="var(--node-unit)" filter="url(#glow-content)" class="content-node" />
      <text x="95" y="64" class="node-label node-label-content">単元</text>
    </g>
    <!-- 単元B -->
    <g class="content-node-group" style="--delay:0.3s">
      <circle cx="450" cy="65" r="7" fill="var(--node-unit)" filter="url(#glow-content)" class="content-node" />
      <text x="450" y="49" class="node-label node-label-content">単元</text>
    </g>
    <!-- 単元C -->
    <g class="content-node-group" style="--delay:0.6s">
      <circle cx="810" cy="155" r="7" fill="var(--node-unit)" filter="url(#glow-content)" class="content-node" />
      <text x="810" y="139" class="node-label node-label-content">単元</text>
    </g>
    <!-- 読書A -->
    <g class="content-node-group" style="--delay:0.2s">
      <circle cx="805" cy="340" r="7" fill="var(--node-book)" filter="url(#glow-content)" class="content-node" />
      <text x="805" y="363" class="node-label node-label-content">読書</text>
    </g>
    <!-- 思考A -->
    <g class="content-node-group" style="--delay:0.5s">
      <circle cx="95" cy="370" r="7" fill="var(--node-note)" filter="url(#glow-content)" class="content-node" />
      <text x="95" y="393" class="node-label node-label-content">思考</text>
    </g>
    <!-- 思考B -->
    <g class="content-node-group" style="--delay:0.8s">
      <circle cx="450" cy="385" r="7" fill="var(--node-note)" filter="url(#glow-content)" class="content-node" />
      <text x="450" y="408" class="node-label node-label-content">思考</text>
    </g>

    <!-- ────────── 概念ノード（大）────────── -->
    <!-- 帝国主義（中央） -->
    <g class="concept-node-group central" style="--delay:0s">
      <circle cx="450" cy="210" r="22" fill="var(--node-concept)" opacity="0.15" class="pulse-ring" />
      <circle cx="450" cy="210" r="16" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
      <text x="450" y="186" class="node-label node-label-concept">帝国主義</text>
    </g>
    <!-- 国民国家 -->
    <g class="concept-node-group" style="--delay:0.4s">
      <circle cx="220" cy="130" r="18" fill="var(--node-concept)" opacity="0.15" class="pulse-ring" />
      <circle cx="220" cy="130" r="13" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
      <text x="220" y="109" class="node-label node-label-concept">国民国家</text>
    </g>
    <!-- 植民地 -->
    <g class="concept-node-group" style="--delay:0.8s">
      <circle cx="680" cy="130" r="18" fill="var(--node-concept)" opacity="0.15" class="pulse-ring" />
      <circle cx="680" cy="130" r="13" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
      <text x="680" y="109" class="node-label node-label-concept">植民地</text>
    </g>
    <!-- 近代化 -->
    <g class="concept-node-group" style="--delay:1.2s">
      <circle cx="190" cy="310" r="18" fill="var(--node-concept)" opacity="0.15" class="pulse-ring" />
      <circle cx="190" cy="310" r="13" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
      <text x="190" y="289" class="node-label node-label-concept">近代化</text>
    </g>
    <!-- 主権 -->
    <g class="concept-node-group" style="--delay:1.6s">
      <circle cx="710" cy="310" r="18" fill="var(--node-concept)" opacity="0.15" class="pulse-ring" />
      <circle cx="710" cy="310" r="13" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
      <text x="710" y="289" class="node-label node-label-concept">主権</text>
    </g>
  </svg>
</div>

<style>
  .network-hero-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .network-svg {
    width: 100%;
    height: 100%;
  }

  /* ── エッジのアニメーション ── */
  .edge {
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
    animation: draw-edge 2s ease forwards;
  }
  .edge:nth-child(1)  { animation-delay: 0.1s; }
  .edge:nth-child(2)  { animation-delay: 0.2s; }
  .edge:nth-child(3)  { animation-delay: 0.3s; }
  .edge:nth-child(4)  { animation-delay: 0.4s; }
  .edge:nth-child(5)  { animation-delay: 0.5s; }
  .edge:nth-child(6)  { animation-delay: 0.6s; }
  .edge:nth-child(7)  { animation-delay: 0.7s; }
  .edge:nth-child(8)  { animation-delay: 0.8s; }
  .edge:nth-child(9)  { animation-delay: 0.9s; }
  .edge:nth-child(10) { animation-delay: 1.0s; }
  .edge:nth-child(11) { animation-delay: 1.1s; }
  .edge:nth-child(12) { animation-delay: 1.2s; }

  .edge-secondary { stroke-opacity: 0.5; }
  .edge-content   { stroke-opacity: 0.4; stroke-dasharray: 3 4; }

  @keyframes draw-edge {
    to { stroke-dashoffset: 0; }
  }

  /* ── 概念ノード パルス ── */
  .concept-node {
    animation: concept-pulse 3s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes concept-pulse {
    0%, 100% { opacity: 0.9; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.08); }
  }

  .pulse-ring {
    animation: ring-expand 3s ease-out infinite;
    animation-delay: var(--delay, 0s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes ring-expand {
    0%   { transform: scale(1); opacity: 0.15; }
    70%  { transform: scale(1.8); opacity: 0; }
    100% { transform: scale(1); opacity: 0; }
  }

  /* ── コンテンツノード ── */
  .content-node {
    animation: content-pulse 4s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes content-pulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.15); }
  }

  /* ── ラベルテキスト ── */
  .node-label {
    font-family: "Noto Sans JP", sans-serif;
    text-anchor: middle;
    pointer-events: none;
    user-select: none;
  }
  .node-label-concept {
    font-size: 13px;
    font-weight: 700;
    fill: var(--text);
    letter-spacing: 0.05em;
  }
  .node-label-content {
    font-size: 9px;
    fill: var(--text-muted);
    letter-spacing: 0.08em;
  }
</style>
