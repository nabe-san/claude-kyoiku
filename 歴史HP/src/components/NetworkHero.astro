---
// 概念ネットワークの抽象ビジュアル — ラベルなし、右寄せ配置
---

<div class="network-hero-wrap" aria-hidden="true">
  <svg
    viewBox="0 0 900 420"
    preserveAspectRatio="xMidYMid slice"
    class="network-svg"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <filter id="glow-concept" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="5" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
      <filter id="glow-content" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>

      <!-- エッジパス（animateMotion 用） -->
      <path id="e-im-ko" d="M620,210 L400,130" />
      <path id="e-im-sh" d="M620,210 L840,130" />
      <path id="e-im-ki" d="M620,210 L370,310" />
      <path id="e-im-su" d="M620,210 L850,310" />
      <path id="e-ko-su" d="M400,130 L850,310" />
      <path id="e-sh-su" d="M840,130 L850,310" />
      <path id="e-ua-ko" d="M270,80  L400,130" />
      <path id="e-ub-im" d="M620,65  L620,210" />
      <path id="e-uc-sh" d="M870,155 L840,130" />
      <path id="e-ba-su" d="M865,355 L850,310" />
      <path id="e-na-ki" d="M270,380 L370,310" />
      <path id="e-nb-im" d="M620,390 L620,210" />

      <radialGradient id="hero-grad" cx="65%" cy="50%" r="55%">
        <stop offset="0%"   stop-color="var(--hero-to)"   />
        <stop offset="100%" stop-color="var(--hero-from)"  />
      </radialGradient>
    </defs>

    <!-- 背景 -->
    <rect width="900" height="420" fill="url(#hero-grad)" />

    <!-- ────────── エッジ ────────── -->
    <g stroke="var(--edge-color)" stroke-width="1.2" fill="none">
      <use href="#e-im-ko" class="edge" />
      <use href="#e-im-sh" class="edge" />
      <use href="#e-im-ki" class="edge" />
      <use href="#e-im-su" class="edge" />
      <use href="#e-ko-su" class="edge edge-secondary" />
      <use href="#e-sh-su" class="edge edge-secondary" />
      <use href="#e-ua-ko" class="edge edge-content" />
      <use href="#e-ub-im" class="edge edge-content" />
      <use href="#e-uc-sh" class="edge edge-content" />
      <use href="#e-ba-su" class="edge edge-content" />
      <use href="#e-na-ki" class="edge edge-content" />
      <use href="#e-nb-im" class="edge edge-content" />
    </g>

    <!-- ────────── 動くドット ────────── -->
    <g fill="var(--node-concept)" opacity="0.8">
      <circle r="2.5">
        <animateMotion dur="4s" repeatCount="indefinite" begin="0s"><mpath href="#e-im-ko"/></animateMotion>
      </circle>
      <circle r="2.5">
        <animateMotion dur="5s" repeatCount="indefinite" begin="1.5s"><mpath href="#e-im-sh"/></animateMotion>
      </circle>
      <circle r="2.5">
        <animateMotion dur="4.5s" repeatCount="indefinite" begin="2.5s"><mpath href="#e-im-ki"/></animateMotion>
      </circle>
      <circle r="2.5">
        <animateMotion dur="5.5s" repeatCount="indefinite" begin="0.8s"><mpath href="#e-im-su"/></animateMotion>
      </circle>
      <circle r="2" opacity="0.7">
        <animateMotion dur="3.5s" repeatCount="indefinite" begin="1s"><mpath href="#e-ub-im"/></animateMotion>
      </circle>
      <circle r="2" opacity="0.7">
        <animateMotion dur="4.2s" repeatCount="indefinite" begin="3s"><mpath href="#e-ba-su"/></animateMotion>
      </circle>
      <circle r="2" opacity="0.7">
        <animateMotion dur="3.8s" repeatCount="indefinite" begin="2s"><mpath href="#e-nb-im"/></animateMotion>
      </circle>
    </g>

    <!-- ────────── 周辺ノード（小・ラベルなし）────────── -->
    <g fill="var(--node-concept)" opacity="0.55">
      <circle cx="270" cy="80"  r="5"  class="content-node" style="--delay:0s"   filter="url(#glow-content)" />
      <circle cx="620" cy="65"  r="5"  class="content-node" style="--delay:0.3s" filter="url(#glow-content)" />
      <circle cx="870" cy="155" r="5"  class="content-node" style="--delay:0.6s" filter="url(#glow-content)" />
      <circle cx="865" cy="355" r="5"  class="content-node" style="--delay:0.2s" filter="url(#glow-content)" />
      <circle cx="270" cy="380" r="5"  class="content-node" style="--delay:0.5s" filter="url(#glow-content)" />
      <circle cx="620" cy="390" r="5"  class="content-node" style="--delay:0.8s" filter="url(#glow-content)" />
    </g>

    <!-- ────────── 概念ノード（大・ラベルなし）────────── -->
    <!-- 帝国主義（中央） -->
    <g class="concept-node-group" style="--delay:0s">
      <circle cx="620" cy="210" r="22" fill="var(--node-concept)" opacity="0.12" class="pulse-ring" />
      <circle cx="620" cy="210" r="16" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
    </g>
    <!-- 国民国家 -->
    <g class="concept-node-group" style="--delay:0.4s">
      <circle cx="400" cy="130" r="18" fill="var(--node-concept)" opacity="0.12" class="pulse-ring" />
      <circle cx="400" cy="130" r="12" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
    </g>
    <!-- 植民地 -->
    <g class="concept-node-group" style="--delay:0.8s">
      <circle cx="840" cy="130" r="18" fill="var(--node-concept)" opacity="0.12" class="pulse-ring" />
      <circle cx="840" cy="130" r="12" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
    </g>
    <!-- 近代化 -->
    <g class="concept-node-group" style="--delay:1.2s">
      <circle cx="370" cy="310" r="18" fill="var(--node-concept)" opacity="0.12" class="pulse-ring" />
      <circle cx="370" cy="310" r="12" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
    </g>
    <!-- 主権 -->
    <g class="concept-node-group" style="--delay:1.6s">
      <circle cx="850" cy="310" r="18" fill="var(--node-concept)" opacity="0.12" class="pulse-ring" />
      <circle cx="850" cy="310" r="12" fill="var(--node-concept)" filter="url(#glow-concept)" class="concept-node" />
    </g>
  </svg>
</div>

<style>
  .network-hero-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .network-svg {
    width: 100%;
    height: 100%;
  }

  /* ── エッジ draw-in ── */
  .edge {
    stroke-dasharray: 600;
    stroke-dashoffset: 600;
    animation: draw-edge 2s ease forwards;
  }
  .edge:nth-child(1)  { animation-delay: 0.1s; }
  .edge:nth-child(2)  { animation-delay: 0.25s; }
  .edge:nth-child(3)  { animation-delay: 0.4s; }
  .edge:nth-child(4)  { animation-delay: 0.55s; }
  .edge:nth-child(5)  { animation-delay: 0.7s; }
  .edge:nth-child(6)  { animation-delay: 0.85s; }
  .edge:nth-child(7)  { animation-delay: 1.0s; }
  .edge:nth-child(8)  { animation-delay: 1.1s; }
  .edge:nth-child(9)  { animation-delay: 1.2s; }
  .edge:nth-child(10) { animation-delay: 1.3s; }
  .edge:nth-child(11) { animation-delay: 1.4s; }
  .edge:nth-child(12) { animation-delay: 1.5s; }

  .edge-secondary { stroke-opacity: 0.45; }
  .edge-content   { stroke-opacity: 0.3; stroke-dasharray: 3 5; }

  @keyframes draw-edge {
    to { stroke-dashoffset: 0; }
  }

  /* ── 概念ノード パルス ── */
  .concept-node {
    animation: concept-pulse 3.5s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes concept-pulse {
    0%, 100% { opacity: 0.88; transform: scale(1); }
    50%       { opacity: 1;    transform: scale(1.07); }
  }

  .pulse-ring {
    animation: ring-expand 3.5s ease-out infinite;
    animation-delay: var(--delay, 0s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes ring-expand {
    0%   { transform: scale(1);   opacity: 0.12; }
    60%  { transform: scale(2.2); opacity: 0; }
    100% { transform: scale(1);   opacity: 0; }
  }

  /* ── 周辺ノード ── */
  .content-node {
    animation: content-pulse 4.5s ease-in-out infinite;
    animation-delay: var(--delay, 0s);
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes content-pulse {
    0%, 100% { opacity: 0.45; transform: scale(1); }
    50%       { opacity: 0.7;  transform: scale(1.2); }
  }
</style>
