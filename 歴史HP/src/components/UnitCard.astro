---
import ConceptBadge from './ConceptBadge.astro';
import SubjectBadge from './SubjectBadge.astro';
import LineIcon from './LineIcon.astro';

interface Props {
  id: string;
  title: string;
  subject: 'history-general' | 'japanese-history' | 'civics';
  concepts: string[];
  bigQuestion: string;
}
const { id, title, subject, concepts, bigQuestion } = Astro.props;
---

<article class="unit-card card">
  <!-- カード全体のクリック領域（透明オーバーレイ） -->
  <a href={`/units/${id}/`} class="card-overlay" aria-label={title}></a>

  <div class="source-strip" aria-hidden="true">
    <div class="source-map">
      <span class="map-line line-a"></span>
      <span class="map-line line-b"></span>
      <span class="map-line line-c"></span>
      <span class="map-dot dot-a"></span>
      <span class="map-dot dot-b"></span>
      <span class="map-dot dot-c"></span>
    </div>
    <div class="source-mark"><LineIcon name="map" size={18} /></div>
  </div>

  <div class="unit-card-header">
    <SubjectBadge subject={subject} />
    <span class="unit-card-arrow">→</span>
  </div>

  <h3 class="unit-card-title">{title}</h3>

  <p class="unit-card-question">{bigQuestion}</p>

  <div class="unit-card-concepts">
    {concepts.slice(0, 3).map(c => <ConceptBadge concept={c} size="sm" />)}
    {concepts.length > 3 && <span class="more-badge">+{concepts.length - 3}</span>}
  </div>
</article>

<style>
  .unit-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: inherit;
    overflow: hidden;
  }

  /* カード全体を覆う透明リンク */
  .card-overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }

  /* 概念タグはオーバーレイより前面に（クリック可能にする） */
  .unit-card-concepts {
    position: relative;
    z-index: 1;
  }

  .source-strip {
    position: relative;
    height: 78px;
    margin: -1.5rem -1.5rem 0.25rem;
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(115deg, rgba(146, 64, 14, 0.08), transparent 55%),
      repeating-linear-gradient(
        0deg,
        rgba(146, 64, 14, 0.06) 0 1px,
        transparent 1px 14px
      ),
      var(--bg-surface);
  }

  .source-map {
    position: absolute;
    inset: 0;
    opacity: 0.7;
  }

  .map-line {
    position: absolute;
    height: 1px;
    background: color-mix(in srgb, var(--primary) 52%, transparent);
    transform-origin: left center;
  }

  .line-a {
    width: 68%;
    left: 12%;
    top: 60%;
    transform: rotate(-12deg);
  }

  .line-b {
    width: 52%;
    left: 38%;
    top: 27%;
    transform: rotate(18deg);
  }

  .line-c {
    width: 38%;
    left: 6%;
    top: 28%;
    transform: rotate(27deg);
    opacity: 0.42;
  }

  .map-dot {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--primary);
    opacity: 0.55;
  }

  .dot-a { left: 22%; top: 46%; }
  .dot-b { left: 57%; top: 35%; }
  .dot-c { left: 80%; top: 57%; }

  .source-mark {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    color: var(--primary);
    opacity: 0.72;
  }

  .unit-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .unit-card-arrow {
    color: var(--text-dim);
    font-size: 1.1rem;
    transition: transform 0.2s, color 0.2s;
  }

  .unit-card:hover .unit-card-arrow {
    transform: translateX(3px);
    color: var(--primary);
  }

  .unit-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.4;
    font-family: "Noto Serif JP", serif;
  }

  .unit-card-question {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .unit-card-concepts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }

  .more-badge {
    display: inline-block;
    padding: 0.2em 0.6em;
    font-size: 0.72rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 100px;
  }
</style>
