---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  SUBJECT_ORDER,
  SUBJECT_LABELS,
  buildConceptCategoryMap,
  buildCategoryOrder,
} from '../../lib/concepts';

const units = await getCollection('units');
const books = await getCollection('books');

// 概念タグごとのコンテンツ件数を集計（単元＋読書ノート）
const conceptCountMap = new Map<string, number>();
for (const unit of units) {
  for (const c of unit.data.concepts) {
    conceptCountMap.set(c, (conceptCountMap.get(c) ?? 0) + 1);
  }
}
for (const book of books) {
  for (const c of book.data.concepts) {
    conceptCountMap.set(c, (conceptCountMap.get(c) ?? 0) + 1);
  }
}
const usedConcepts = [...conceptCountMap.keys()];

// マスター語彙にないタグの科目推定（単元の subject から。複数科目にまたがる場合あり）
const unitSubjectsByConcept = new Map<string, Set<string>>();
for (const unit of units) {
  for (const c of unit.data.concepts) {
    if (!unitSubjectsByConcept.has(c)) unitSubjectsByConcept.set(c, new Set());
    unitSubjectsByConcept.get(c)!.add(unit.data.subject);
  }
}

const categoryMap = buildConceptCategoryMap();
const categoryOrder = buildCategoryOrder();

const sortByCount = (a: string, b: string) => (conceptCountMap.get(b) ?? 0) - (conceptCountMap.get(a) ?? 0);

// 科目 → カテゴリ → タグ の構造を構築
const subjectSections = SUBJECT_ORDER.map((subject) => {
  const categories = categoryOrder[subject] ?? [];
  const groups = categories
    .map((category) => ({
      category,
      tags: usedConcepts
        .filter((name) => categoryMap.get(name)?.get(subject) === category)
        .sort(sortByCount),
    }))
    .filter((g) => g.tags.length > 0);

  // 語彙にはまだ載っていないが、この科目の単元で使われているタグ
  const uncategorized = usedConcepts
    .filter((name) => !categoryMap.has(name) && unitSubjectsByConcept.get(name)?.has(subject))
    .sort(sortByCount);
  if (uncategorized.length > 0) {
    groups.push({ category: '未分類', tags: uncategorized });
  }

  return { subject, label: SUBJECT_LABELS[subject], groups };
});

// どの科目の語彙にも単元にも紐づかないタグ（主に読書ノート由来の自由記述タグ）
const otherTags = usedConcepts
  .filter((name) => !categoryMap.has(name) && !unitSubjectsByConcept.has(name))
  .sort(sortByCount);
---

<BaseLayout title="概念タグ一覧">
  <header class="page-header">
    <div class="container">
      <h1 class="page-title">概念タグ</h1>
      <p class="page-desc">
        ひとつの概念タグが、単元・読書ノート・思考ノートを横断的につなぐ。
        気になる概念から探索を始めよう。
      </p>
    </div>
  </header>

  <div class="filter-bar">
    <div class="container">
      <div class="filter-buttons" role="group" aria-label="科目で絞り込む">
        <button class="filter-btn active" data-subject="all">すべて</button>
        {SUBJECT_ORDER.map((subject) => (
          <button class="filter-btn" data-subject={subject}>{SUBJECT_LABELS[subject]}</button>
        ))}
      </div>
    </div>
  </div>

  <div class="container" style="padding: 3rem 1.5rem 5rem;">
    {subjectSections.map(({ subject, label, groups }) => groups.length > 0 && (
      <section class="subject-section" data-subject={subject}>
        <h2 class="subject-title">{label}</h2>
        {groups.map(({ category, tags }) => (
          <div class="category-group">
            <h3 class="category-title">{category}</h3>
            <div class="concepts-list">
              {tags.map((concept) => (
                <a href={`/concepts/${encodeURIComponent(concept)}/`} class="concept-row">
                  <span class="concept-name">
                    <span class="concept-hash">#</span>{concept}
                  </span>
                  <span class="concept-count">{conceptCountMap.get(concept)} 件</span>
                  <span class="concept-arrow">→</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </section>
    ))}

    {otherTags.length > 0 && (
      <section class="subject-section" data-subject="">
        <h2 class="subject-title">その他（未分類）</h2>
        <div class="concepts-list">
          {otherTags.map((concept) => (
            <a href={`/concepts/${encodeURIComponent(concept)}/`} class="concept-row">
              <span class="concept-name">
                <span class="concept-hash">#</span>{concept}
              </span>
              <span class="concept-count">{conceptCountMap.get(concept)} 件</span>
              <span class="concept-arrow">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <p class="empty-message" id="empty-message">この科目の概念タグはまだありません。</p>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const sections = document.querySelectorAll<HTMLElement>('.subject-section');
  const emptyMsg = document.getElementById('empty-message')!;

  function updateEmptyState() {
    const anyVisible = [...sections].some((s) => !s.hidden);
    emptyMsg.hidden = anyVisible;
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const subject = btn.dataset.subject!;
      filterBtns.forEach((b) => b.classList.toggle('active', b === btn));

      sections.forEach((section) => {
        const sectionSubject = section.dataset.subject ?? '';
        section.hidden = !(subject === 'all' || sectionSubject === subject);
      });

      updateEmptyState();
    });
  });

  updateEmptyState();
</script>

<style>
  .page-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-family: "Noto Serif JP", serif;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .page-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 55ch;
  }

  /* ── フィルターバー（/units/ と同じパターン） ── */
  .filter-bar {
    background: var(--bg-surface);
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 60px;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .filter-btn {
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
    font-family: "Noto Sans JP", sans-serif;
    font-weight: 500;
    border-radius: 8px;
    border: 1.5px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s, box-shadow 0.15s;
    min-height: 48px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .filter-btn:hover:not(.active) {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(146, 64, 14, 0.05);
  }

  .filter-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 2px 10px rgba(146, 64, 14, 0.3);
  }

  /* ── 科目セクション ── */
  .subject-section {
    margin-bottom: 3rem;
  }
  .subject-section:last-of-type {
    margin-bottom: 0;
  }
  .subject-title {
    font-size: 1.3rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .category-group {
    margin-bottom: 1.75rem;
  }
  .category-group:last-child {
    margin-bottom: 0;
  }
  .category-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-bottom: 0.6rem;
  }

  .concepts-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .concept-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .concept-row:hover {
    border-color: var(--border-hover);
    transform: translateX(4px);
    box-shadow: var(--shadow-sm);
  }

  .concept-name {
    flex: 1;
    font-size: 1.05rem;
    font-weight: 600;
    font-family: "Noto Serif JP", serif;
    color: var(--text);
  }
  .concept-hash {
    color: var(--primary);
    margin-right: 0.15em;
  }

  .concept-count {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .concept-arrow {
    color: var(--text-dim);
    transition: transform 0.2s, color 0.2s;
  }
  .concept-row:hover .concept-arrow {
    transform: translateX(3px);
    color: var(--primary);
  }

  .empty-message {
    text-align: center;
    color: var(--text-dim);
    padding: 4rem 0;
    font-size: 1rem;
  }
</style>
