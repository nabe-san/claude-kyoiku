---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnitCard from '../../components/UnitCard.astro';
import { getCollection } from 'astro:content';
import { SUBJECT_LABELS, buildConceptCategoryMap } from '../../lib/concepts';

export async function getStaticPaths() {
  const units = await getCollection('units');
  const books = await getCollection('books');
  const notes = await getCollection('notes');

  const allConcepts = [...new Set([
    ...units.flatMap(u => u.data.concepts),
    ...books.flatMap(b => b.data.concepts),
    ...notes.flatMap(n => n.data.concepts),
  ])];

  return allConcepts.map(concept => ({
    params: { concept },
    props: {
      concept,
      matchedUnits: units.filter(u => u.data.concepts.includes(concept)),
      matchedBooks: books.filter(b => b.data.concepts.includes(concept)),
      matchedNotes: notes.filter(n => n.data.concepts.includes(concept)),
    },
  }));
}

const { concept, matchedUnits, matchedBooks, matchedNotes } = Astro.props;

// この概念タグが科目別マスター語彙のどのカテゴリに属するか
const classifications = [...(buildConceptCategoryMap().get(concept)?.entries() ?? [])];
---

<BaseLayout title={`概念タグ: ${concept}`}>

  <header class="concept-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">ホーム</a>
        <span>›</span>
        <a href="/concepts/">概念タグ一覧</a>
        <span>›</span>
        <span>{concept}</span>
      </nav>

      <div class="concept-badge-large">
        <span class="concept-hash">#</span>{concept}
      </div>

      <p class="concept-desc">
        このタグを持つコンテンツをすべて表示しています。
      </p>

      {classifications.length > 0 && (
        <div class="concept-classifications">
          {classifications.map(([subject, category]) => (
            <span class="classification-badge">{SUBJECT_LABELS[subject]} › {category}</span>
          ))}
        </div>
      )}

      <div class="concept-counts">
        <span class="count-item">
          <span class="count-num">{matchedUnits.length}</span>
          <span class="count-label">授業構成</span>
        </span>
        <span class="count-item">
          <span class="count-num">{matchedBooks.length}</span>
          <span class="count-label">読書ノート</span>
        </span>
        <span class="count-item">
          <span class="count-num">{matchedNotes.length}</span>
          <span class="count-label">思考ノート</span>
        </span>
      </div>
    </div>
  </header>

  <div class="concept-body">
    <div class="container">

      {matchedUnits.length > 0 && (
        <section class="result-section">
          <h2 class="result-title">
            <span class="result-icon unit-icon-sm">構</span>
            授業構成
          </h2>
          <div class="units-grid">
            {matchedUnits.map(unit => (
              <UnitCard
                id={unit.id}
                title={unit.data.title}
                subject={unit.data.subject}
                concepts={unit.data.concepts}
                bigQuestion={unit.data.bigQuestion}
              />
            ))}
          </div>
        </section>
      )}

      {matchedBooks.length > 0 && (
        <section class="result-section">
          <h2 class="result-title">
            <span class="result-icon book-icon-sm">読</span>
            読書ノート
          </h2>
          <div class="books-list">
            {matchedBooks.map(book => (
              <a href={`/books/${book.id}/`} class="book-row">
                <span class="book-row-title">{book.data.title}</span>
                <span class="book-row-meta">{book.data.author}{book.data.year ? ` · ${book.data.year}年` : ''}</span>
                <span class="book-row-arrow">→</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {matchedNotes.length > 0 && (
        <section class="result-section">
          <h2 class="result-title">
            <span class="result-icon note-icon-sm">思</span>
            思考ノート
          </h2>
          <div class="books-list">
            {matchedNotes.map(note => (
              <a href={`/notes/${note.id}/`} class="book-row">
                <span class="book-row-title">{note.data.title}</span>
                <span class="book-row-arrow">→</span>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </div>

</BaseLayout>

<style>
  .concept-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }
  .breadcrumb a { color: var(--text-muted); }
  .breadcrumb a:hover { color: var(--primary); }

  .concept-badge-large {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2em;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .concept-hash {
    color: var(--primary);
    font-size: 0.7em;
  }

  .concept-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
  }

  .concept-classifications {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .classification-badge {
    font-size: 0.78rem;
    color: var(--primary);
    border: 1px solid rgba(146, 64, 14, 0.3);
    border-radius: 100px;
    padding: 0.3em 0.9em;
    background: rgba(146, 64, 14, 0.06);
  }

  .concept-counts {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .count-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .count-num {
    font-size: 1.6rem;
    font-weight: 700;
    font-family: "Inter", sans-serif;
    color: var(--primary);
    line-height: 1;
  }
  .count-label {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* ── ボディ ── */
  .concept-body {
    padding: 3rem 0 4rem;
    background: var(--bg);
  }

  .result-section {
    margin-bottom: 3rem;
  }
  .result-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .result-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: "Noto Serif JP", serif;
  }
  .unit-icon-sm { background: rgba(110, 231, 183, 0.15); color: var(--node-unit); }
  .book-icon-sm { background: rgba(252, 211, 77, 0.12);  color: var(--node-book); }
  .note-icon-sm { background: rgba(249, 168, 212, 0.12); color: var(--node-note); }

  .books-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .book-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .book-row:hover {
    border-color: var(--border-hover);
    transform: translateX(3px);
  }

  .book-row-title {
    flex: 1;
    font-size: 0.95rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 600;
    color: var(--text);
  }

  .book-row-meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .book-row-arrow {
    color: var(--text-dim);
    transition: transform 0.15s, color 0.15s;
  }
  .book-row:hover .book-row-arrow {
    transform: translateX(3px);
    color: var(--primary);
  }

  .units-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
</style>
