---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnitCard from '../../components/UnitCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const units = await getCollection('units');

  // 将来：books と notes も同様に getCollection して概念タグで紐付ける
  // const books = await getCollection('books');
  // const notes = await getCollection('notes');

  const allConcepts = [...new Set(units.flatMap(u => u.data.concepts))];

  return allConcepts.map(concept => ({
    params: { concept },
    props: {
      concept,
      matchedUnits: units.filter(u => u.data.concepts.includes(concept)),
      // 将来ここに matchedBooks, matchedNotes を追加
    },
  }));
}

const { concept, matchedUnits } = Astro.props;
---

<BaseLayout title={`概念タグ: ${concept}`}>

  <header class="concept-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">ホーム</a>
        <span>›</span>
        <a href="/concepts/">概念タグ一覧</a>
        <span>›</span>
        <span>{concept}</span>
      </nav>

      <div class="concept-badge-large">
        <span class="concept-hash">#</span>{concept}
      </div>

      <p class="concept-desc">
        このタグを持つコンテンツをすべて表示しています。
      </p>

      <div class="concept-counts">
        <span class="count-item">
          <span class="count-num">{matchedUnits.length}</span>
          <span class="count-label">授業単元</span>
        </span>
        <span class="count-item">
          <span class="count-num">0</span>
          <span class="count-label">読書ノート</span>
        </span>
        <span class="count-item">
          <span class="count-num">0</span>
          <span class="count-label">思考ノート</span>
        </span>
      </div>
    </div>
  </header>

  <div class="concept-body">
    <div class="container">

      {matchedUnits.length > 0 && (
        <section class="result-section">
          <h2 class="result-title">
            <span class="result-icon unit-icon-sm">単</span>
            授業単元
          </h2>
          <div class="units-grid">
            {matchedUnits.map(unit => (
              <UnitCard
                id={unit.id}
                title={unit.data.title}
                subject={unit.data.subject}
                concepts={unit.data.concepts}
                bigQuestion={unit.data.bigQuestion}
              />
            ))}
          </div>
        </section>
      )}

      <!-- 将来：読書ノート・思考ノートのセクションをここに追加 -->
      <section class="result-section coming">
        <h2 class="result-title">
          <span class="result-icon book-icon-sm">読</span>
          読書ノート
          <span class="soon-tag">近日追加</span>
        </h2>
      </section>

      <section class="result-section coming">
        <h2 class="result-title">
          <span class="result-icon note-icon-sm">思</span>
          思考ノート
          <span class="soon-tag">近日追加</span>
        </h2>
      </section>

    </div>
  </div>

</BaseLayout>

<style>
  .concept-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.75rem;
  }
  .breadcrumb a { color: var(--text-muted); }
  .breadcrumb a:hover { color: var(--primary); }

  .concept-badge-large {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2em;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .concept-hash {
    color: var(--primary);
    font-size: 0.7em;
  }

  .concept-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
  }

  .concept-counts {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .count-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .count-num {
    font-size: 1.6rem;
    font-weight: 700;
    font-family: "Inter", sans-serif;
    color: var(--primary);
    line-height: 1;
  }
  .count-label {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  /* ── ボディ ── */
  .concept-body {
    padding: 3rem 0 4rem;
    background: var(--bg);
  }

  .result-section {
    margin-bottom: 3rem;
  }
  .result-section.coming {
    opacity: 0.5;
  }

  .result-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  .result-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: "Noto Serif JP", serif;
  }
  .unit-icon-sm { background: rgba(110, 231, 183, 0.15); color: var(--node-unit); }
  .book-icon-sm { background: rgba(252, 211, 77, 0.12);  color: var(--node-book); }
  .note-icon-sm { background: rgba(249, 168, 212, 0.12); color: var(--node-note); }

  .soon-tag {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-dim);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    padding: 0.15em 0.6em;
    border-radius: 100px;
    font-family: "Noto Sans JP", sans-serif;
  }

  .units-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }
</style>
