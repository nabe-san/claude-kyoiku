---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptBadge from '../../components/ConceptBadge.astro';
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes')).sort(
  (a, b) => b.id.localeCompare(a.id)
);
---

<BaseLayout title="思考ノート">
  <header class="page-header">
    <div class="container">
      <h1 class="page-title">思考ノート</h1>
      <p class="page-desc">
        考え続けていることを載せていきます。
      </p>
    </div>
  </header>

  <div class="container notes-container">
    {notes.length > 0 && (
      <div class="notes-list">
        {notes.map(note => (
          <a href={`/notes/${note.id}/`} class="note-row">
            <h2 class="note-row-title">{note.data.title}</h2>
            <p class="note-row-question">{note.data.question}</p>
            {note.data.concepts.length > 0 && (
              <div class="note-row-concepts">
                {note.data.concepts.slice(0, 4).map(c => <ConceptBadge concept={c} size="sm" />)}
              </div>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-family: "Noto Serif JP", serif;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .page-desc {
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 60ch;
    line-height: 1.8;
  }

  .notes-container {
    padding: 3rem 1.5rem 5rem;
  }

  .notes-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 72ch;
  }

  .note-row {
    display: block;
    padding: 1.5rem 1.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .note-row:hover {
    border-color: var(--primary);
    box-shadow: var(--shadow-sm);
  }

  .note-row-title {
    font-size: 1.15rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .note-row-question {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .note-row-concepts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
