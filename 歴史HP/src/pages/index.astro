---
import BaseLayout from '../layouts/BaseLayout.astro';
import NetworkHero from '../components/NetworkHero.astro';
import UnitCard from '../components/UnitCard.astro';
import ConceptBadge from '../components/ConceptBadge.astro';
import LineIcon from '../components/LineIcon.astro';
import { getCollection } from 'astro:content';

const units = await getCollection('units');

// 全概念タグを収集・重複除去
const allConcepts = [...new Set(units.flatMap(u => u.data.concepts))];
---

<BaseLayout title="歴史教師の探究ノート" description="歴史総合・日本史探究・公共の授業設計と思考の記録。概念タグで単元・読書・思考を横断する。">

  <!-- ══════════════ HERO ══════════════ -->
  <section class="hero">
    <NetworkHero />
    <div class="archive-layer" aria-hidden="true">
      <div class="archive-sheet sheet-map">
        <span class="coast coast-a"></span>
        <span class="coast coast-b"></span>
        <span class="route route-a"></span>
        <span class="route route-b"></span>
        <span class="port port-a"></span>
        <span class="port port-b"></span>
      </div>
      <div class="archive-sheet sheet-note">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <div class="container">
        <div class="hero-inner">
          <p class="hero-eyebrow">歴史総合・日本史探究・公共</p>
          <h1 class="hero-title">
            概念でつながる、<br />知識の地図。
          </h1>
          <p class="hero-desc">
            授業の設計、読書の記録、授業で生まれた問い——<br />
            概念タグが、それらをひとつの知識の網として編み上げる。
          </p>
          <div class="hero-actions">
            <a href="/concepts/" class="btn btn-primary">概念タグを探す</a>
            <a href="/units/" class="btn btn-ghost">授業単元を見る</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ FEATURES ══════════════ -->
  <section class="section features-section">
    <div class="container">
      <div class="section-title">
        <h2>このサイトにあるもの</h2>
        <p>授業設計の裏側を、3つの角度から記録する</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon unit-icon"><LineIcon name="map" size={24} /></div>
          <h3>授業単元</h3>
          <p>
            「大きな問い」と授業の全体像を軸にした授業設計ノート。
            なぜこの問いを立てたかという設計の裏側まで記録する。
          </p>
        </div>
        <div class="feature-card">
          <div class="feature-icon book-icon"><LineIcon name="book" size={24} /></div>
          <h3>読書ノート</h3>
          <p>
            授業設計に影響を与えた本の記録。
            要約ではなく「この本から何を授業に持ち込んだか」の視点で書く。
          </p>
          <span class="coming-soon">近日追加</span>
        </div>
        <div class="feature-card">
          <div class="feature-icon note-icon"><LineIcon name="thought" size={24} /></div>
          <h3>思考ノート</h3>
          <p>
            授業を設計しながら浮かんだ問い、うまくいかなかった実践の記録。
            失敗も含めた思考の痕跡。
          </p>
          <span class="coming-soon">近日追加</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════ CONCEPTS ══════════════ -->
  <section class="section concepts-section">
    <div class="container">
      <div class="section-title">
        <h2>概念タグ</h2>
        <p>ひとつのタグが、単元・読書・思考を串刺しにする</p>
      </div>
      <div class="concepts-cloud">
        {allConcepts.map(c => <ConceptBadge concept={c} />)}
      </div>
      <div style="text-align:center; margin-top:2rem;">
        <a href="/concepts/" class="btn btn-ghost">すべての概念タグを見る →</a>
      </div>
    </div>
  </section>

  <!-- ══════════════ RECENT UNITS ══════════════ -->
  {units.length > 0 && (
    <section class="section recent-section">
      <div class="container">
        <div class="section-title">
          <h2>最近の授業単元</h2>
        </div>
        <div class="units-grid">
          {units.slice(0, 3).map(unit => (
            <UnitCard
              id={unit.id}
              title={unit.data.title}
              subject={unit.data.subject}
              concepts={unit.data.concepts}
              bigQuestion={unit.data.bigQuestion}
              visual={unit.data.visual}
            />
          ))}
        </div>
        <div style="text-align:center; margin-top:2.5rem;">
          <a href="/units/" class="btn btn-ghost">全単元を見る →</a>
        </div>
      </div>
    </section>
  )}

  <!-- ══════════════ ABOUT ══════════════ -->
  <section class="section about-section">
    <div class="container">
      <div class="about-inner">
        <div class="about-text">
          <h2>このサイトについて</h2>
          <p>
            神奈川県立高校で地理歴史・公民科を担当する教員が運営する個人サイトです。
            歴史総合・日本史探究・公共の授業内容を中心に、
            設計の意図や参考にした文献を記録しています。
          </p>
          <p>
            「知識を知っている」ではなく「概念を自分の言葉で語れる」状態を目指した
            授業設計のノートとして、生徒・保護者・同業の先生に公開しています。
          </p>
        </div>
        <div class="about-stat-grid">
          <div class="about-stat">
            <LineIcon name="map" size={20} />
            <span class="stat-num">{units.length}</span>
            <span class="stat-label">授業単元</span>
          </div>
          <div class="about-stat">
            <LineIcon name="tag" size={20} />
            <span class="stat-num">{allConcepts.length}</span>
            <span class="stat-label">概念タグ</span>
          </div>
          <div class="about-stat">
            <LineIcon name="book" size={20} />
            <span class="stat-num">0</span>
            <span class="stat-label">読書ノート</span>
          </div>
          <div class="about-stat">
            <LineIcon name="notebook" size={20} />
            <span class="stat-num">0</span>
            <span class="stat-label">思考ノート</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* テキスト領域を保護するグラデーションオーバーレイ */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    background: linear-gradient(
      to right,
      var(--bg) 0%,
      var(--bg) 28%,
      transparent 62%
    );
    pointer-events: none;
  }

  .archive-layer {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    opacity: 0.72;
  }

  .archive-sheet {
    position: absolute;
    border: 1px solid rgba(146, 64, 14, 0.13);
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.26), rgba(146, 64, 14, 0.05)),
      repeating-linear-gradient(
        0deg,
        rgba(146, 64, 14, 0.07) 0 1px,
        transparent 1px 18px
      );
    box-shadow: 0 18px 50px rgba(146, 64, 14, 0.08);
  }

  .sheet-map {
    width: min(36vw, 460px);
    height: min(28vw, 330px);
    right: 7vw;
    top: 16vh;
    transform: rotate(-4deg);
    opacity: 0.32;
    overflow: hidden;
  }

  .sheet-note {
    width: min(22vw, 280px);
    height: min(16vw, 210px);
    right: 23vw;
    bottom: 10vh;
    transform: rotate(6deg);
    opacity: 0.18;
    padding: 2.2rem 1.8rem;
  }

  .sheet-note span {
    display: block;
    height: 1px;
    margin-bottom: 1.15rem;
    background: rgba(146, 64, 14, 0.32);
  }

  .coast,
  .route {
    position: absolute;
    display: block;
    border-color: rgba(146, 64, 14, 0.35);
  }

  .coast {
    border: 1px solid;
    border-radius: 44% 56% 52% 48%;
  }

  .coast-a {
    width: 58%;
    height: 70%;
    left: -12%;
    top: 20%;
    transform: rotate(18deg);
  }

  .coast-b {
    width: 42%;
    height: 52%;
    right: -10%;
    top: -4%;
    transform: rotate(-20deg);
    opacity: 0.62;
  }

  .route {
    height: 1px;
    border-top: 1px dashed rgba(146, 64, 14, 0.45);
    transform-origin: left center;
  }

  .route-a {
    width: 78%;
    left: 12%;
    top: 42%;
    transform: rotate(-16deg);
  }

  .route-b {
    width: 62%;
    left: 22%;
    top: 66%;
    transform: rotate(14deg);
  }

  .port {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--primary);
    opacity: 0.75;
  }

  .port-a { left: 35%; top: 35%; }
  .port-b { left: 68%; top: 58%; }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 6rem 0 5rem;
  }

  .hero-inner {
    max-width: 560px;
  }

  .hero-eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--primary);
    margin-bottom: 1.25rem;
    opacity: 0.85;
  }

  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--text);
    margin-bottom: 1.5rem;
    word-break: keep-all;
  }

  .hero-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.9;
    margin-bottom: 2.5rem;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── Features ── */
  .features-section {
    background: var(--bg-surface);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  .feature-card::after {
    content: "";
    position: absolute;
    inset: auto 1.2rem 1.2rem auto;
    width: 90px;
    height: 90px;
    opacity: 0.08;
    background:
      linear-gradient(var(--primary), var(--primary)) 18px 20px / 54px 1px no-repeat,
      linear-gradient(var(--primary), var(--primary)) 18px 36px / 42px 1px no-repeat,
      linear-gradient(var(--primary), var(--primary)) 18px 52px / 58px 1px no-repeat,
      linear-gradient(var(--primary), var(--primary)) 18px 68px / 35px 1px no-repeat;
    border: 1px solid var(--primary);
    transform: rotate(-5deg);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    font-weight: 700;
    font-family: "Noto Serif JP", serif;
    margin-bottom: 1.25rem;
  }
  .unit-icon { background: rgba(110, 231, 183, 0.15); color: var(--node-unit); }
  .book-icon { background: rgba(252, 211, 77, 0.12);  color: var(--node-book); }
  .note-icon { background: rgba(249, 168, 212, 0.12); color: var(--node-note); }

  .feature-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
    color: var(--text);
  }
  .feature-card p {
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
  }

  .coming-soon {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.2em 0.7em;
    font-size: 0.72rem;
    border-radius: 100px;
    background: var(--bg-elevated);
    color: var(--text-dim);
    border: 1px solid var(--border);
  }

  /* ── Concepts ── */
  .concepts-section {
    background: var(--bg);
  }

  .concepts-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
    max-width: 700px;
    margin: 0 auto;
  }

  /* ── Recent Units ── */
  .recent-section {
    background: var(--bg-surface);
  }

  .units-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  /* ── About ── */
  .about-section {
    background: var(--bg);
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .about-text h2 {
    margin-bottom: 1.25rem;
  }

  .about-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .about-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    color: var(--primary);
  }

  .stat-num {
    font-size: 2.5rem;
    font-weight: 700;
    font-family: "Inter", sans-serif;
    color: var(--primary);
    line-height: 1;
    margin-top: 0.7rem;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .about-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-inner {
      max-width: 100%;
    }
    .archive-layer {
      opacity: 0.32;
    }
    .sheet-map {
      width: 80vw;
      height: 52vw;
      right: -34vw;
      top: 18vh;
    }
    .sheet-note {
      display: none;
    }
  }
</style>
