---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptBadge from '../../components/ConceptBadge.astro';
import SubjectBadge from '../../components/SubjectBadge.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const units = await getCollection('units');
  return units.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, subject, concepts, bigQuestion, subQuestion, overview, keyTerms, keywords, answer, relatedBooks, relatedNotes, materials } = entry.data;
const displayedKeyTerms = keyTerms ?? keywords ?? [];

const allBooks = await getCollection('books');
const linkedBooks = allBooks.filter(b => relatedBooks.includes(b.id));
---

<BaseLayout title={title}>
  <!-- ── ① ヘッダー ── -->
  <header class="unit-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">ホーム</a>
        <span>›</span>
        <a href="/units/">単元一覧</a>
        <span>›</span>
        <span>{title}</span>
      </nav>

      <div class="unit-meta">
        <SubjectBadge subject={subject} />
      </div>

      <h1 class="unit-title">{title}</h1>

      <div class="concept-tags">
        {concepts.map(c => <ConceptBadge concept={c} />)}
      </div>
    </div>
  </header>

  <!-- ── ② 大きな問い ── -->
  <section class="big-question-section">
    <div class="container">
      <div class="big-question-band">
        <span class="big-question-label">大きな問い</span>
        <p class="big-question-text">{bigQuestion}</p>
        {subQuestion && (
          <p class="sub-question-text">{subQuestion}</p>
        )}
      </div>
    </div>
  </section>

  <!-- ── ③ 授業の全体像 ── -->
  {overview && (
    <section class="unit-overview">
      <div class="container">
        <span class="section-micro-label">授業の全体像</span>
        <p class="overview-text">{overview}</p>
      </div>
    </section>
  )}

  <!-- ── ④ 関連語句 ── -->
  {displayedKeyTerms.length > 0 && (
    <div class="unit-key-terms">
      <div class="container">
        <span class="section-micro-label">関連語句</span>
        <p class="key-terms-flow">{displayedKeyTerms.join('　')}</p>
      </div>
    </div>
  )}

  <!-- ── ⑤ 本文（授業で話したこと）── -->
  <article class="unit-body">
    <div class="container">
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>

  <!-- ── ④ 配布資料 ── -->
  {materials.length > 0 && (
    <section class="materials-section">
      <div class="container">
        <h2 class="side-section-title">配布資料</h2>
        <ul class="materials-list">
          {materials.map(m => (
            <li class="material-item">
              <span class="material-icon">📄</span>
              <a href={m.file} class="material-link" download>
                {m.label}
              </a>
              <span class="material-note">（PDF）</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ── ⑤ 関連書籍 ── -->
  {linkedBooks.length > 0 && (
    <section class="related-section">
      <div class="container">
        <h2 class="side-section-title">関連読書ノート</h2>
        <div class="book-cards">
          {linkedBooks.map(book => (
            <a href={`/books/${book.id}/`} class="book-card card" style="text-decoration:none;color:inherit;">
              <p class="book-card-author">{book.data.author}{book.data.year ? `（${book.data.year}）` : ''}</p>
              <h3 class="book-title">{book.data.title}</h3>
              {book.data.summary && <p class="book-summary">{book.data.summary}</p>}
              <span class="btn btn-ghost" style="margin-top:0.75rem; font-size:0.82rem; display:inline-block;">
                読書ノートを読む →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ── ⑥ 関連思考ノート（未実装・スキップ） ── -->

  <!-- ── ⑦ 大きな問いへの答え ── -->
  {answer && (
    <section class="unit-answer">
      <div class="container">
        <div class="answer-band">
          <span class="answer-label">この問いへの答え</span>
          <p class="answer-question-echo">{bigQuestion}</p>
          <p class="answer-text">{answer}</p>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* ── ヘッダー ── */
  .unit-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--text-muted); }
  .breadcrumb a:hover { color: var(--primary); }

  .unit-meta {
    margin-bottom: 1rem;
  }

  .unit-title {
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    line-height: 1.3;
  }

  .concept-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ── 大きな問い ── */
  .big-question-section {
    background: var(--bg);
    padding: 2.5rem 0;
  }

  .big-question-band {
    position: relative;
    background: var(--bg-elevated);
    border-left: 4px solid var(--primary);
    border-radius: 0 12px 12px 0;
    padding: 1.75rem 2rem;
    box-shadow: var(--shadow-glow);
  }

  .big-question-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }

  .big-question-text {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    line-height: 1.6;
    margin: 0;
  }

  .sub-question-text {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0.9rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }

  /* ── 授業の全体像 ── */
  .unit-overview {
    padding: 2.5rem 0;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .section-micro-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }
  .overview-text {
    max-width: 72ch;
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── 関連語句 ── */
  .unit-key-terms {
    background: var(--bg-surface);
    padding: 1.5rem 0 2rem;
    border-bottom: 1px solid var(--border);
  }
  .key-terms-flow {
    font-size: 0.9rem;
    font-family: "Noto Serif JP", serif;
    color: var(--text-muted);
    line-height: 2;
    margin: 0.5rem 0 0;
    max-width: 72ch;
  }

  /* ── 大きな問いへの答え ── */
  .unit-answer {
    padding: 3rem 0 4rem;
    background: var(--bg-surface);
    border-top: 2px solid var(--primary);
  }
  .answer-band {
    border-left: 4px solid var(--primary);
    border-radius: 0 12px 12px 0;
    padding: 1.75rem 2rem;
    background: var(--bg-elevated);
    box-shadow: var(--shadow-glow);
  }
  .answer-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: 0.75rem;
  }
  .answer-question-echo {
    font-size: 1rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text-muted);
    margin: 0 0 1rem;
    line-height: 1.6;
  }
  .answer-text {
    font-size: 1rem;
    line-height: 1.85;
    color: var(--text);
    margin: 0;
  }

  /* ── 本文 ── */
  .unit-body {
    padding: 3.5rem 0;
    background: var(--bg);
  }

  /* ── 配布資料 ── */
  .materials-section {
    padding: 2.5rem 0;
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
  }

  .side-section-title {
    font-size: 1.1rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .materials-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .material-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .material-icon { font-size: 1rem; }
  .material-link {
    color: var(--primary);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .material-link:hover { text-decoration: underline; }
  .material-note {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  /* ── 関連書籍・ノート ── */
  .related-section {
    padding: 2.5rem 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .book-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }
  .book-card { padding: 1.5rem; }
  .book-title {
    font-size: 1rem;
    font-family: "Noto Serif JP", serif;
    color: var(--text);
    margin-bottom: 0.6rem;
  }
  .book-summary {
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 0;
  }

  .note-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .note-link-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    padding: 1rem 1.5rem;
  }
  .note-link-label {
    font-size: 0.72rem;
    color: var(--node-note);
    font-weight: 600;
    padding: 0.2em 0.6em;
    background: rgba(249, 168, 212, 0.1);
    border-radius: 100px;
    white-space: nowrap;
  }
  .note-link-title {
    flex: 1;
    font-size: 0.95rem;
    color: var(--text);
  }
  .note-link-arrow {
    color: var(--text-dim);
    transition: transform 0.2s, color 0.2s;
  }
  .note-link-card:hover .note-link-arrow {
    transform: translateX(3px);
    color: var(--primary);
  }
</style>
