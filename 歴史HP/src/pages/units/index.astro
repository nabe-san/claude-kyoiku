---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnitCard from '../../components/UnitCard.astro';
import { getCollection } from 'astro:content';
import { historyGeneralCurriculum } from '../../lib/curriculum';

const units = await getCollection('units');

// 各概念タグがどの科目に属するかを計算（複数科目にまたがる場合あり）
const conceptSubjectsMap = new Map<string, Set<string>>();
units.forEach(u => {
  u.data.concepts.forEach(c => {
    if (!conceptSubjectsMap.has(c)) conceptSubjectsMap.set(c, new Set());
    conceptSubjectsMap.get(c)!.add(u.data.subject);
  });
});
const allConcepts = [...conceptSubjectsMap.entries()];

// 歴史総合：教科書目次（部→章→節）に沿って授業構成ページを割り当てる
const historyUnits = units.filter(u => u.data.subject === 'history-general');
const unitByPosition = new Map<string, (typeof historyUnits)[number]>();
for (const u of historyUnits) {
  if (u.data.chapter != null && u.data.section != null) {
    unitByPosition.set(`${u.data.chapter}-${u.data.section}`, u);
  }
}

const PART_ROMAN = ['', 'Ⅰ', 'Ⅱ', 'Ⅲ'];

const curriculumParts = (historyGeneralCurriculum?.parts ?? []).map(part => ({
  ...part,
  roman: PART_ROMAN[part.number] ?? String(part.number),
  chapters: (historyGeneralCurriculum?.chapters ?? [])
    .filter(c => c.part === part.number)
    .map(chapter => ({
      ...chapter,
      sections: chapter.sections.map((title, idx) => {
        const sectionNumber = idx + 1;
        return {
          number: sectionNumber,
          title,
          unit: unitByPosition.get(`${chapter.number}-${sectionNumber}`),
        };
      }),
    })),
}));
---

<BaseLayout title="授業一覧">
  <header class="page-header">
    <div class="container">
      <h1 class="page-title">授業構成</h1>
      <p class="page-desc">「大きな問い」と授業の全体像を軸にした授業設計ノート。</p>
    </div>
  </header>

  <!-- ── 科目フィルター ── -->
  <div class="filter-bar">
    <div class="container">
      <div class="filter-buttons" role="group" aria-label="科目で絞り込む">
        <button class="filter-btn active" data-subject="all">すべて</button>
        <button class="filter-btn" data-subject="history-general">歴史総合</button>
        <button class="filter-btn" data-subject="japanese-history">日本史探究</button>
        <button class="filter-btn" data-subject="civics">公共</button>
      </div>
    </div>
  </div>

  <!-- ── 概念タグ（科目連動） ── -->
  <div class="concepts-bar" id="concepts-bar">
    <div class="container">
      <p class="concepts-label">この科目の概念タグ</p>
      <div class="concepts-row" id="concepts-row">
        {allConcepts.map(([concept, subjects]) => (
          <a
            href={`/concepts/${concept}/`}
            class="concept-chip"
            data-subjects={[...subjects].join(',')}
          >
            {concept}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ── 歴史総合：教科書目次に沿った構成表示 ── -->
  <div class="container curriculum-container" id="curriculum-view" hidden>
    {curriculumParts.map(part => (
      <section class="curriculum-part">
        <h2 class="part-title">第{part.roman}部　{part.title}</h2>
        {part.chapters.map(chapter => (
          <div class="curriculum-chapter">
            <h3 class="chapter-title">第{chapter.number}章　{chapter.title}</h3>
            <ol class="section-list">
              {chapter.sections.map(section => (
                <li>
                  {section.unit ? (
                    <UnitCard
                      id={section.unit.id}
                      title={`${section.number}　${section.unit.data.title}`}
                      subject={section.unit.data.subject}
                      concepts={section.unit.data.concepts}
                      bigQuestion={section.unit.data.bigQuestion}
                      visual={section.unit.data.visual}
                    />
                  ) : (
                    <div class="section-placeholder">
                      <span class="section-num">{section.number}</span>
                      <span class="section-title">{section.title}</span>
                      <span class="section-status">準備中</span>
                    </div>
                  )}
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))}
  </div>

  <!-- ── フラット表示（すべて／日本史探究／公共） ── -->
  <div class="container units-container" id="flat-view">
    <div class="units-grid" id="units-grid">
      {units.map(unit => (
        <div class="unit-wrapper" data-subject={unit.data.subject}>
          <UnitCard
            id={unit.id}
            title={unit.data.title}
            subject={unit.data.subject}
            concepts={unit.data.concepts}
            bigQuestion={unit.data.bigQuestion}
            visual={unit.data.visual}
          />
        </div>
      ))}
    </div>
    <p class="empty-message" id="empty-message">この科目の授業構成はまだありません。</p>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const unitWrappers = document.querySelectorAll<HTMLElement>('.unit-wrapper');
  const conceptChips = document.querySelectorAll<HTMLElement>('.concept-chip');
  const emptyMsg = document.getElementById('empty-message')!;
  const flatView = document.getElementById('flat-view')!;
  const curriculumView = document.getElementById('curriculum-view')!;

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const subject = btn.dataset.subject!;

      // アクティブ状態を切り替え
      filterBtns.forEach(b => b.classList.toggle('active', b === btn));

      // 歴史総合だけは教科書目次ビューに切り替える
      const showCurriculum = subject === 'history-general';
      curriculumView.hidden = !showCurriculum;
      flatView.hidden = showCurriculum;

      if (!showCurriculum) {
        // 単元カードを絞り込む
        let visibleCount = 0;
        unitWrappers.forEach(wrapper => {
          const show = subject === 'all' || wrapper.dataset.subject === subject;
          wrapper.hidden = !show;
          if (show) visibleCount++;
        });
        emptyMsg.hidden = visibleCount > 0;
      }

      // 概念タグを絞り込む
      conceptChips.forEach(chip => {
        const chipSubjects = chip.dataset.subjects?.split(',') ?? [];
        chip.hidden = !(subject === 'all' || chipSubjects.includes(subject));
      });
    });
  });

  // 初期状態：空メッセージは非表示
  emptyMsg.hidden = true;
</script>

<style>
  /* ── ページヘッダー ── */
  .page-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-family: "Noto Serif JP", serif;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .page-desc {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── フィルターバー ── */
  .filter-bar {
    background: var(--bg-surface);
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 60px;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .filter-btn {
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
    font-family: "Noto Sans JP", sans-serif;
    font-weight: 500;
    border-radius: 8px;
    border: 1.5px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s, box-shadow 0.15s;
    min-height: 48px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .filter-btn:hover:not(.active) {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(146, 64, 14, 0.05);
  }

  .filter-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 2px 10px rgba(146, 64, 14, 0.3);
  }

  /* ── 概念タグバー ── */
  .concepts-bar {
    background: var(--bg);
    padding: 1.25rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .concepts-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .concepts-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .concept-chip {
    display: inline-block;
    padding: 0.35em 1em;
    font-size: 0.875rem;
    color: var(--primary);
    border: 1px solid rgba(146, 64, 14, 0.3);
    border-radius: 100px;
    background: rgba(146, 64, 14, 0.06);
    text-decoration: none;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .concept-chip:hover {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  /* ── 単元グリッド ── */
  .units-container {
    padding: 3rem 1.5rem 5rem;
  }

  .units-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.25rem;
  }

  .empty-message {
    text-align: center;
    color: var(--text-dim);
    padding: 4rem 0;
    font-size: 1rem;
  }

  /* ── 教科書目次ビュー ── */
  .curriculum-container {
    padding: 3rem 1.5rem 5rem;
  }

  .curriculum-part {
    margin-bottom: 3.5rem;
  }
  .curriculum-part:last-child {
    margin-bottom: 0;
  }

  .part-title {
    font-size: 1.4rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 2px solid var(--primary);
  }

  .curriculum-chapter {
    margin-bottom: 2.25rem;
  }
  .curriculum-chapter:last-child {
    margin-bottom: 0;
  }

  .chapter-title {
    font-size: 1.05rem;
    font-family: "Noto Serif JP", serif;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1rem;
  }

  .section-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .section-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    min-height: 180px;
    padding: 1.5rem;
    border: 1px dashed var(--border);
    border-radius: 10px;
    color: var(--text-dim);
    opacity: 0.6;
    text-align: center;
  }

  .section-num {
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
  }

  .section-title {
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .section-status {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.2em 0.8em;
    margin-top: 0.25rem;
  }

  /* ── レスポンシブ ── */
  @media (max-width: 600px) {
    .filter-buttons {
      gap: 0.5rem;
    }
    .filter-btn {
      padding: 0.65rem 1.2rem;
      font-size: 0.95rem;
    }
  }
</style>
