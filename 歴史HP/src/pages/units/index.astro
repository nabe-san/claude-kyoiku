---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UnitCard from '../../components/UnitCard.astro';
import CurriculumView from '../../components/CurriculumView.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import {
  historyGeneralCurriculum,
  japaneseHistoryCurriculum,
  civicsCurriculum,
  type CurriculumData,
} from '../../lib/curriculum';

const units = await getCollection('units');

// 各概念タグがどの科目に属するかを計算（複数科目にまたがる場合あり）
const conceptSubjectsMap = new Map<string, Set<string>>();
units.forEach(u => {
  u.data.concepts.forEach(c => {
    if (!conceptSubjectsMap.has(c)) conceptSubjectsMap.set(c, new Set());
    conceptSubjectsMap.get(c)!.add(u.data.subject);
  });
});
const allConcepts = [...conceptSubjectsMap.entries()];

const PART_ROMAN = ['', 'Ⅰ', 'Ⅱ', 'Ⅲ', 'Ⅳ'];

// 教科書目次（部→章→節、または部→章→節グループ→節）に沿って授業構成ページを割り当てる
function buildCurriculumParts(curriculum: CurriculumData | undefined, subjectUnits: CollectionEntry<'units'>[]) {
  const unitByPosition = new Map<string, CollectionEntry<'units'>>();
  for (const u of subjectUnits) {
    if (u.data.chapter != null && u.data.section != null) {
      unitByPosition.set(`${u.data.chapter}-${u.data.group ?? 0}-${u.data.section}`, u);
    }
  }

  return (curriculum?.parts ?? []).map(part => ({
    number: part.number,
    title: part.title,
    roman: PART_ROMAN[part.number] ?? String(part.number),
    chapters: (curriculum?.chapters ?? [])
      .filter(c => c.part === part.number)
      .map(chapter => {
        if (chapter.groups) {
          return {
            number: chapter.number,
            title: chapter.title,
            standalone: false,
            kind: 'groups' as const,
            groups: chapter.groups.map((group, gi) => ({
              title: group.title,
              sections: group.sections.map((title, si) => {
                const sectionNumber = si + 1;
                return {
                  number: sectionNumber,
                  title,
                  unit: unitByPosition.get(`${chapter.number}-${gi + 1}-${sectionNumber}`),
                };
              }),
            })),
          };
        }
        return {
          number: chapter.number,
          title: chapter.title,
          standalone: chapter.standalone ?? false,
          kind: 'flat' as const,
          sections: (chapter.sections ?? []).map((title, si) => {
            const sectionNumber = si + 1;
            return {
              number: sectionNumber,
              title,
              unit: unitByPosition.get(`${chapter.number}-0-${sectionNumber}`),
            };
          }),
        };
      }),
  }));
}

const historyCurriculumParts = buildCurriculumParts(
  historyGeneralCurriculum,
  units.filter(u => u.data.subject === 'history-general')
);
const japaneseHistoryCurriculumParts = buildCurriculumParts(
  japaneseHistoryCurriculum,
  units.filter(u => u.data.subject === 'japanese-history')
);
const civicsCurriculumParts = buildCurriculumParts(
  civicsCurriculum,
  units.filter(u => u.data.subject === 'civics')
);
---

<BaseLayout title="授業一覧">
  <header class="page-header">
    <div class="container">
      <h1 class="page-title">授業構成</h1>
      <p class="page-desc">「大きな問い」と授業の全体像を軸にした授業設計ノート。</p>
    </div>
  </header>

  <!-- ── 科目フィルター ── -->
  <div class="filter-bar">
    <div class="container">
      <div class="filter-buttons" role="group" aria-label="科目で絞り込む">
        <button class="filter-btn active" data-subject="all">すべて</button>
        <button class="filter-btn" data-subject="history-general">歴史総合</button>
        <button class="filter-btn" data-subject="japanese-history">日本史探究</button>
        <button class="filter-btn" data-subject="civics">公共</button>
      </div>
    </div>
  </div>

  <!-- ── 概念タグ（科目連動） ── -->
  <div class="concepts-bar" id="concepts-bar">
    <div class="container">
      <p class="concepts-label">この科目の概念タグ</p>
      <div class="concepts-row" id="concepts-row">
        {allConcepts.map(([concept, subjects]) => (
          <a
            href={`/concepts/${concept}/`}
            class="concept-chip"
            data-subjects={[...subjects].join(',')}
          >
            {concept}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ── 教科書目次に沿った構成表示（歴史総合・日本史探究・公共） ── -->
  <CurriculumView id="curriculum-view-history-general" parts={historyCurriculumParts} />
  <CurriculumView id="curriculum-view-japanese-history" parts={japaneseHistoryCurriculumParts} />
  <CurriculumView id="curriculum-view-civics" parts={civicsCurriculumParts} />

  <!-- ── フラット表示（すべて／日本史探究） ── -->
  <div class="container units-container" id="flat-view">
    <div class="units-grid" id="units-grid">
      {units.map(unit => (
        <div class="unit-wrapper" data-subject={unit.data.subject}>
          <UnitCard
            id={unit.id}
            title={unit.data.title}
            subject={unit.data.subject}
            concepts={unit.data.concepts}
            bigQuestion={unit.data.bigQuestion}
            visual={unit.data.visual}
          />
        </div>
      ))}
    </div>
    <p class="empty-message" id="empty-message">この科目の授業構成はまだありません。</p>
  </div>
</BaseLayout>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const unitWrappers = document.querySelectorAll<HTMLElement>('.unit-wrapper');
  const conceptChips = document.querySelectorAll<HTMLElement>('.concept-chip');
  const emptyMsg = document.getElementById('empty-message')!;
  const flatView = document.getElementById('flat-view')!;
  const curriculumViews: Record<string, HTMLElement> = {
    'history-general': document.getElementById('curriculum-view-history-general')!,
    'japanese-history': document.getElementById('curriculum-view-japanese-history')!,
    civics: document.getElementById('curriculum-view-civics')!,
  };

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const subject = btn.dataset.subject!;

      // アクティブ状態を切り替え
      filterBtns.forEach(b => b.classList.toggle('active', b === btn));

      // 教科書目次ビューを持つ科目はそちらに切り替える
      const curriculumView = curriculumViews[subject];
      Object.values(curriculumViews).forEach(v => { v.hidden = v !== curriculumView; });
      flatView.hidden = !!curriculumView;

      if (!curriculumView) {
        // 単元カードを絞り込む
        let visibleCount = 0;
        unitWrappers.forEach(wrapper => {
          const show = subject === 'all' || wrapper.dataset.subject === subject;
          wrapper.hidden = !show;
          if (show) visibleCount++;
        });
        emptyMsg.hidden = visibleCount > 0;
      }

      // 概念タグを絞り込む
      conceptChips.forEach(chip => {
        const chipSubjects = chip.dataset.subjects?.split(',') ?? [];
        chip.hidden = !(subject === 'all' || chipSubjects.includes(subject));
      });
    });
  });

  // 初期状態：空メッセージは非表示
  emptyMsg.hidden = true;
</script>

<style>
  /* ── ページヘッダー ── */
  .page-header {
    padding: 3rem 0 2.5rem;
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-family: "Noto Serif JP", serif;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .page-desc {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ── フィルターバー ── */
  .filter-bar {
    background: var(--bg-surface);
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 60px;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .filter-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .filter-btn {
    padding: 0.75rem 1.75rem;
    font-size: 1rem;
    font-family: "Noto Sans JP", sans-serif;
    font-weight: 500;
    border-radius: 8px;
    border: 1.5px solid var(--border);
    background: var(--bg-card);
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s, box-shadow 0.15s;
    min-height: 48px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .filter-btn:hover:not(.active) {
    border-color: var(--primary);
    color: var(--primary);
    background: rgba(146, 64, 14, 0.05);
  }

  .filter-btn.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 2px 10px rgba(146, 64, 14, 0.3);
  }

  /* ── 概念タグバー ── */
  .concepts-bar {
    background: var(--bg);
    padding: 1.25rem 0 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .concepts-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .concepts-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .concept-chip {
    display: inline-block;
    padding: 0.35em 1em;
    font-size: 0.875rem;
    color: var(--primary);
    border: 1px solid rgba(146, 64, 14, 0.3);
    border-radius: 100px;
    background: rgba(146, 64, 14, 0.06);
    text-decoration: none;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .concept-chip:hover {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
  }

  /* ── 単元グリッド ── */
  .units-container {
    padding: 3rem 1.5rem 5rem;
  }

  .units-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: 1.25rem;
  }

  .empty-message {
    text-align: center;
    color: var(--text-dim);
    padding: 4rem 0;
    font-size: 1rem;
  }

  /* ── レスポンシブ ── */
  @media (max-width: 600px) {
    .filter-buttons {
      gap: 0.5rem;
    }
    .filter-btn {
      padding: 0.65rem 1.2rem;
      font-size: 0.95rem;
    }
  }
</style>
