{
  "$ref": "#/definitions/units",
  "definitions": {
    "units": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subject": {
          "type": "string",
          "enum": [
            "history-general",
            "japanese-history",
            "civics"
          ]
        },
        "visual": {
          "type": "string",
          "enum": [
            "imperialism",
            "industrial",
            "insei",
            "default"
          ],
          "default": "default"
        },
        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bigQuestion": {
          "type": "string"
        },
        "subQuestion": {
          "type": "string"
        },
        "overview": {
          "type": "string"
        },
        "keyTerms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "answer": {
          "type": "string"
        },
        "relatedBooks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "relatedNotes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "file": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "file"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "subject",
        "concepts",
        "bigQuestion"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}